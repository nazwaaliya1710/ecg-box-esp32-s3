void drawBootTitle() {
  uint16_t row[232];
  for (int y = 0; y < 40; ++y) {
    for (int x = 0; x < 232; ++x) {
      uint8_t value = pgm_read_byte(bootTitle + (y * 232 + x) / 2);
      uint8_t alpha = (x & 1) ? (value & 15) : (value >> 4);
      row[x] = blendPixel(WHITE, 0x0000, alpha);
    }
    tft.drawRGBBitmap((WIDTH - 232) / 2, 124 + y, row, 232, 1);
  }
}
void showStartup() {
  tft.fillScreen(WHITE);
  drawBootTitle();
  tft.fillRoundRect(120, 186, 240, 10, 5, PALE);
  for (int i = 0; i < 20; ++i) {
    tft.fillRect(123 + (234 * i) / 20, 189, (234 * (i + 1)) / 20 - (234 * i) / 20, 4, 0x0000);
    delay(LOADING_MS / 20);
  }


  tft.fillScreen(PAPER);
  tft.fillRect(0, 0, WIDTH, 42, NAVY);
  constexpr char creditsTitle[] = "ECG BOX - CREATED WITH LOVE BY";
  constexpr int creditsWidth = (sizeof(creditsTitle) - 1) * 12;
  static_assert(creditsWidth <= WIDTH - 24, "Credits title must fit");
  drawText((WIDTH - creditsWidth) / 2, 13, creditsTitle, WHITE, 2, NAVY);
  drawText(24, 56, "DOSEN", SOFT_INK, 1, PAPER);
  drawText(24, 72, "EDITA ROSANA WIDASARI", INK, 2, PAPER);
  // Gunakan font sistem GFX untuk gelar agar jarak karakter dan tanda baca rapi.
  tft.setFont();
  tft.setTextSize(2);
  tft.setTextColor(SOFT_INK, PAPER);
  tft.setCursor(24, 92);
  tft.print("S.T., M.T., M.Eng., Ph.D.");
  tft.setTextSize(1);
  tft.drawFastHLine(24, 119, WIDTH - 48, BORDER);
  drawText(24, 127, "TIM MAHASISWA", SOFT_INK, 1, PAPER);
  const char *names[] = {
    "SYAIFUL MUKMININ HIDAYATULLAH",
    "AGATHA TRIOTAMA",
    "LAYLA AFIFAH RAMADHANI",
    "NAZWA ALIYA RAMADHANI"
  };
  const char *studentIds[] = {
    "205150307111021", "245150300111020", "245150301111007", "245150307111062"
  };
  // Semua nama dan NIM rata kiri pada garis x yang sama (24 px).
  // Ukuran font seragam dan jarak antaranggota tetap.
  constexpr uint8_t TEAM_NAME_SIZE = 2;
  constexpr uint8_t TEAM_ID_SIZE = 1;
  constexpr int TEAM_LEFT = 24;
  for (int i = 0; i < 4; ++i) {
    const int y = 144 + 43 * i;
    drawText(TEAM_LEFT, y, names[i], INK, TEAM_NAME_SIZE, PAPER);
    drawText(TEAM_LEFT, y + 20, studentIds[i], SOFT_INK, TEAM_ID_SIZE, PAPER);
  }
  delay(CREDITS_MS);
}
// ================= SETUP & LOOP =================
void setup() {
  Serial.begin(115200);
  pinMode(PIN_ECG_OUT, INPUT);
  pinMode(PIN_ECG_LO_PLUS, INPUT);  // Sama seperti ECG2 (output push-pull AD8232)
  pinMode(PIN_ECG_LO_MINUS, INPUT);
  analogReadResolution(12);
  analogSetPinAttenuation(PIN_ECG_OUT, ADC_11db);


  SPI.begin(PIN_TFT_SCK, -1, PIN_TFT_MOSI, PIN_TFT_CS);
  tft.init(320, 480, 0, 0, ST7796S_BGR);
  tft.setRotation(3);
  tft.setSPISpeed(20000000);
  // ST7796S datasheet: normal display, full color, 16-bit RGB565.
  // Set the register directly: Adafruit swaps the invertDisplay() opcodes
  // for its own panel, whose polarity differs from the panel in the video.
  uint8_t pixelFormat = 0x55;
  tft.sendCommand(0x3A, &pixelFormat, 1);
  tft.sendCommand(0x38);  // IDMOFF: full color
  tft.sendCommand(0x13);  // NORON: full display area
  tft.sendCommand(0x20);  // INVOFF: correct negative colors observed in the video
  tft.setTextWrap(false);
  pinMode(RED_KEY, INPUT_PULLUP);
  pinMode(BLUE_KEY, INPUT_PULLUP);
  showStartup();
  allocateWaves();
  initDiagnostics();
  startDashboard();


  rawADC = -1;
  resetPanTompkins();
  samples = xQueueCreate(ECG_QUEUE_CAPACITY, sizeof(Sample));
  if (!samples || xTaskCreatePinnedToCore(acquire, "ecg_adc", 4096, nullptr, 4, &acquisitionTask, 1) != pdPASS) {
    drawText(8, 20, "AKUISISI GAGAL", RED, 2);
    for (;;) delay(1000);
  }
  esp_timer_create_args_t tickConfig = {};
  tickConfig.callback = ecgTimerNotify;
  tickConfig.name = "ecg_200hz";
  tickConfig.dispatch_method = ESP_TIMER_TASK;
  if (esp_timer_create(&tickConfig, &acquisitionTimer) != ESP_OK ||
      esp_timer_start_periodic(acquisitionTimer, SAMPLE_PERIOD_US) != ESP_OK) {
    drawText(8, 20, "TIMER 200HZ GAGAL", RED, 2);
    Serial.println("ECG ERROR: esp_timer cannot start");
    for (;;) delay(1000);
  }
  Serial.printf("ECG: 200Hz timer active, queue=%u, cores ADC=1 UI=1 NET=0\n", (unsigned)ECG_QUEUE_CAPACITY);
}


void loop() {
  Sample s;
  // Jalur DSP selalu didahulukan dari renderer TFT dan tombol.
  // 128 slot adalah burst ceiling (~0.64s) agar tidak ada starvation UI.
  for (int n = 0; n < 128 && xQueueReceive(samples, &s, 0) == pdTRUE; ++n)
    sampleSensor(s.ms, s.slot, s.adc, s.plus, s.minus);
  buttons();
  uint32_t now = millis();
  // Tunggu sampai indeks terakhir direkam dan diproses, bukan hanya
  // menghitung 60 detik dari UI ketika masih ada backlog di antrean.
  const int32_t recordProgressSlots = recordBaseValid ? (int32_t)(latestProcessedSlot - recordBaseSlot) : -1;
  const uint32_t recordingElapsed = now - sessionStart;
  if (mode == RECORD &&
      ((recordingElapsed >= SESSION_MS && recordProgressSlots >= (int32_t)TRACE_LEN - 1) ||
       recordingElapsed >= SESSION_MS + 1500)) {
    if (recordProgressSlots < (int32_t)TRACE_LEN - 1)
      Serial.println("ECG WARNING: recording finished with missing or unprocessed slots");
    saveCompletedSession();
    mode = RESULTS;
    redraw = true;
    for (int i = 0; i < BINS; ++i) {
      Serial.printf("end_s=%d covered_ms=%lu bpm=", (i + 1) * 10, (unsigned long)covered[i]);
      if (covered[i] >= 7000) Serial.println(60000.0f * beatUnits[i] / covered[i], 2);
      else Serial.println("NA");
    }
  }
  if (stateMutex) {
    xSemaphoreTake(stateMutex, portMAX_DELAY);
    recordedRemaining = mode == RECORD ? int((SESSION_MS - min(uint32_t(now - sessionStart), SESSION_MS) + 999) / 1000) : -1;
    xSemaphoreGive(stateMutex);
  }
  if (redraw) {
    if (mode == RESULTS) showResults();
    else {
      drawStaticUI();
      plotCursor = 0;
      newPlotSegment = true;
      lastPlotMs = 0;
      drawDynamicUI();
    }
    redraw = false;
  }
  if (mode != RESULTS) {
    // Jam rendering mandiri: satu kolom setiap 10 ms, termasuk saat
    // antrean kosong, elektroda lepas, atau ADC tidak tersedia.
    // Jangan menggambar burst beberapa kolom sesudah operasi TFT yang berat.
    uint32_t plotNow = millis();
    // Saat terjadi backlog, dahulukan data ECG dibanding menggambar TFT.
    // Grafik dapat tertunda sementara, data ECG tetap diproses.
    const bool dspCaughtUp = !samples || uxQueueMessagesWaiting(samples) < 40;
    if (dspCaughtUp && (lastPlotMs == 0 || plotNow - lastPlotMs >= PLOT_PERIOD_MS)) {
      lastPlotMs = plotNow;
      // Bandpass referensi murni; skala/AA hanya bekerja di fungsi drawPlot().
      drawPlot(displaySignal);
    }
    if (now - lastUiMs >= 200) {
      lastUiMs = now;
      drawDynamicUI();
    }
  }
  if (now - lastLogMs >= LOG_PERIOD_MS) {
    lastLogMs = now;
    lastAdcSpan = sampleCount ? adcMax - adcMin : 0;
    lastAdcDiff = adcDiffAvg;
    int adcMinLog = sampleCount ? adcMin : -1, adcMaxLog = sampleCount ? adcMax : -1;
    adcMin = 4095;
    adcMax = 0;
    Serial.printf("adc=%d..%d processed=%lu missed=%lu queueDrop=%lu queue=%u BPM_RR=%d RR=%d CV=%.3f LO=%d%d\n",
                  adcMinLog, adcMaxLog, (unsigned long)sampleCount,
                  (unsigned long)acquisitionMissedTicks, (unsigned long)acquisitionQueueDrops,
                  (unsigned)(samples ? uxQueueMessagesWaiting(samples) : 0),
                  leadsContact && rrCount >= 3 ? bpm : 0,
                  lastRR, rrCV, loPlus, loMinus);
    diagLatestSamplesHz = sampleCount;  // Hanya salin hitungan yang sudah dicatat pada log; tidak mengubah akuisisi.
    sampleCount = 0;
  }
  delay(1);
}