inline int ix(int pos, int k, int n) {
  return ((pos - k) % n + n) % n;
}


// --- Pan-Tompkins and RR averaging restored from user reference ---
void resetPanTompkins() {
  memset(lpX, 0, sizeof(lpX));
  lpPos = 0;
  lpY1 = lpY2 = 0;
  memset(hpX, 0, sizeof(hpX));
  hpPos = 0;
  hpSum = 0;
  memset(derX, 0, sizeof(derX));
  derPos = 0;
  memset(mwiBuf, 0, sizeof(mwiBuf));
  mwiPos = 0;
  spki = npki = thr1 = thr2 = 0;
  prevI1 = prevI2 = maxSlope = lastSlope = 0;
  candVal = candSlope = 0;
  candTime = 0;
  sampleIdx = 0;
  learnMax = learnSum = 0;
  memset(rrAll, 0, sizeof(rrAll));
  memset(rrOk, 0, sizeof(rrOk));
  rrAllCnt = rrAllPos = rrOkCnt = rrOkPos = 0;
  rrAvg1 = rrAvg2 = 0;
  bpm = lastRR = rrCount = 0;
  rrCV = 0;
  irregularFlag = false;
  lastQrsMs = 0;
  displaySignal = 0;
}


// 1) Band-pass = low-pass (~11 Hz) lalu high-pass (~5 Hz)
float bandpass(int adc) {
  const int32_t x = adc - 2048;
  lpPos = (lpPos + 1) % N_LP;
  lpX[lpPos] = x;
  const int32_t yl = 2 * lpY1 - lpY2 + x
                     - 2 * lpX[ix(lpPos, 6, N_LP)] + lpX[ix(lpPos, 12, N_LP)];
  lpY2 = lpY1;
  lpY1 = yl;


  hpPos = (hpPos + 1) % N_HP;
  hpX[hpPos] = yl;
  hpSum += yl - hpX[ix(hpPos, 32, N_HP)];
  const int32_t yh = 32 * hpX[ix(hpPos, 16, N_HP)] - hpSum;
  return (float)yh / (36.0f * 32.0f);
}


// 2) Turunan 5 titik
float derivative(float x) {
  derPos = (derPos + 1) % N_DER;
  derX[derPos] = x;
  return (2.0f * derX[ix(derPos, 0, N_DER)] + derX[ix(derPos, 1, N_DER)]
          - derX[ix(derPos, 3, N_DER)] - 2.0f * derX[ix(derPos, 4, N_DER)])
         / 8.0f;
}


// 3) Moving-window integration
float mwi(float squared) {
  mwiBuf[mwiPos] = squared;
  mwiPos = (mwiPos + 1) % N_MWI;
  float s = 0;
  for (int i = 0; i < N_MWI; ++i) s += mwiBuf[i];
  return s / N_MWI;
}


void updateThresholds() {
  thr1 = npki + 0.25f * (spki - npki);
  thr2 = 0.5f * thr1;
}


// Rate display: accepted RR intervals ending in the last 10 s.
// Benchmark: 6 fixed 10 s bins. Split an RR crossing a bin boundary
// proportionally so each bin represents only its own recording time.
constexpr uint32_t WINDOW_MS = 10000, SESSION_MS = 60000;
constexpr int BINS = SESSION_MS / WINDOW_MS;
enum Mode { MONITOR,
            RECORD,
            RESULTS };
Mode mode = MONITOR;
uint32_t sessionStart;
// Indeks rekaman berasal dari slot sampling 5 ms, BUKAN pembulatan millis().
// Missing timer/queue slots tetap NO_SAMPLE, tidak diduplikasi/interpolasi.
uint32_t recordBaseSlot = 0;
uint32_t recordBaseMs = 0;
bool recordBaseValid = false;
constexpr int SESSION_SLOTS = 8;
constexpr size_t TRACE_LEN = SESSION_MS * FS / 1000;
constexpr uint16_t NO_SAMPLE = 0xffff, QRS_MARK = 0x8000;
// Eight published sessions plus an independent buffer for the current run.
uint16_t *activeWave = nullptr, *waveSlots[SESSION_SLOTS] = {};
uint32_t waveIds[SESSION_SLOTS] = {};
uint16_t detectedBeats = 0;


void allocateWaves() {
  size_t bytes = (SESSION_SLOTS + 1) * TRACE_LEN * sizeof(uint16_t);
  auto *pool = static_cast<uint16_t *>(heap_caps_malloc(bytes, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
  if (!pool) {
    Serial.println("ECG: waveform unavailable; check OPI PSRAM");
    return;
  }
  activeWave = pool;
  for (int i = 0; i < SESSION_SLOTS; ++i) waveSlots[i] = pool + (i + 1) * TRACE_LEN;
}


bool redraw = true;
float beatUnits[BINS];
uint32_t covered[BINS];
// Statistik benchmark 60 detik adalah agregasi interval RR dari QRS ECG2.
// Tidak ada algoritma BPM, detektor puncak atau filter alternatif.
void recordInterval(uint32_t end, uint32_t rr) {
  if (mode != RECORD) return;
  const uint32_t stop = end - sessionStart;
  if (stop < rr || stop > SESSION_MS) return;
  uint32_t begin = stop - rr;
  while (begin < stop) {
    const int bin = begin / WINDOW_MS;
    if (bin >= BINS) break;
    const uint32_t boundary = (bin + 1) * WINDOW_MS;
    const uint32_t part = min(stop, boundary) - begin;
    covered[bin] += part;
    beatUnits[bin] += float(part) / rr;
    begin += part;
  }
}


void acceptQRS(uint32_t t) {
  // ECG Box bookkeeping only. QRS acceptance, RR, BPM and CV below remain
  // byte-for-byte the same arithmetic as the supplied pure reference.
  if (mode == RECORD) {
    const uint32_t elapsed = t - sessionStart;
    if (elapsed < SESSION_MS) {
      ++detectedBeats;
      // Penanda QRS diselaraskan dengan titik pertama di buffer rekaman.
      // Timestamp QRS historis (search-back) tetap bisa menunjuk sampel lama.
      if (recordBaseValid && (uint32_t)(t - recordBaseMs) < SESSION_MS) {
        const size_t index = (size_t(t - recordBaseMs) * FS + 500) / 1000;
        if (activeWave && index < TRACE_LEN && activeWave[index] != NO_SAMPLE)
          activeWave[index] |= QRS_MARK;
      }
    }
  }


  if (lastQrsMs != 0) {
    const uint32_t dt = t - lastQrsMs;
    if (dt >= 300 && dt <= 2000) {
      lastRR = (int)dt;
      rrAll[rrAllPos] = (uint16_t)dt;
      rrAllPos = (rrAllPos + 1) % RR_MAX;
      if (rrAllCnt < RR_MAX) rrAllCnt++;
      rrCount = rrAllCnt;
      recordInterval(t, dt);  // Output-only 10 s benchmark aggregation.


      float sum = 0;
      for (int i = 0; i < rrAllCnt; ++i) sum += rrAll[i];
      rrAvg1 = sum / rrAllCnt;
      float sq = 0;
      for (int i = 0; i < rrAllCnt; ++i) {
        float d = rrAll[i] - rrAvg1;
        sq += d * d;
      }
      rrCV = sqrtf(sq / rrAllCnt) / rrAvg1;
      bpm = (int)roundf(60000.0f / rrAvg1);


      if (rrAvg2 == 0 || (dt >= 0.92f * rrAvg2 && dt <= 1.16f * rrAvg2)) {
        rrOk[rrOkPos] = (uint16_t)dt;
        rrOkPos = (rrOkPos + 1) % RR_MAX;
        if (rrOkCnt < RR_MAX) rrOkCnt++;
        float s2 = 0;
        for (int i = 0; i < rrOkCnt; ++i) s2 += rrOk[i];
        rrAvg2 = s2 / rrOkCnt;
      }
      irregularFlag = rrAllCnt >= 6 && rrCV > 0.16f;
    } else {
      rrAllCnt = rrAllPos = rrOkCnt = rrOkPos = 0;
      rrAvg1 = rrAvg2 = 0;
      rrCount = 0;
      bpm = 0;
      lastRR = 0;
      rrCV = 0;
      irregularFlag = false;
    }
  }
  lastQrsMs = t;
  candVal = 0;
}


// --------- Puncak Pan-Tompkins ECG2: SPKI/NPKI, refractory, T-wave ---------
void handlePeak(float val, uint32_t t, float slope) {
  if (val > thr1) {
    const uint32_t dt = lastQrsMs ? (t - lastQrsMs) : 0xFFFFFFFF;
    if (dt < REFRACTORY_MS) {
      // refractory: abaikan
    } else if (dt < TWAVE_MS && slope < 0.5f * lastSlope) {
      npki = 0.125f * val + 0.875f * npki;  // gelombang T
    } else {
      spki = 0.125f * val + 0.875f * spki;  // QRS
      lastSlope = slope;
      acceptQRS(t);
    }
  } else {
    npki = 0.125f * val + 0.875f * npki;  // noise
    if (val > thr2 && val > candVal && (!lastQrsMs || t - lastQrsMs >= REFRACTORY_MS)) {
      candVal = val;
      candTime = t;
      candSlope = slope;
    }
  }
  updateThresholds();
}


void searchBack(uint32_t nowMs) {
  const float avg = rrAvg2 > 0 ? rrAvg2 : rrAvg1;
  if (lastQrsMs && avg > 0 && candVal > 0 && (nowMs - lastQrsMs) > 1.66f * avg) {
    spki = 0.25f * candVal + 0.75f * spki;
    lastSlope = candSlope;
    acceptQRS(candTime);
    updateThresholds();
  }
}


// Reference: band-pass -> derivative -> square -> MWI -> QRS -> RR mean BPM.
void panTompkins(int adc, uint32_t nowMs) {
  const float bp = bandpass(adc);
  displaySignal = bp;
  const float d = derivative(bp);
  const float integ = mwi(d * d);
  sampleIdx++;


  if (sampleIdx <= SETTLE_N) {
    prevI2 = prevI1;
    prevI1 = integ;
    return;
  }


  if (sampleIdx <= SETTLE_N + LEARN_N) {
    if (integ > learnMax) learnMax = integ;
    learnSum += integ;
    if (sampleIdx == SETTLE_N + LEARN_N) {
      spki = 0.25f * learnMax;
      npki = 0.5f * (learnSum / LEARN_N);
      updateThresholds();
    }
    prevI2 = prevI1;
    prevI1 = integ;
    return;
  }


  const float slope = integ - prevI1;
  if (slope > maxSlope) maxSlope = slope;
  if (prevI1 > prevI2 && prevI1 >= integ) {
    handlePeak(prevI1, nowMs - (1000 / FS), maxSlope);
    maxSlope = 0;
  }
  searchBack(nowMs);
  prevI2 = prevI1;
  prevI1 = integ;
}


// ================= AKUISISI 200 HZ - TIMER PERIODIK =================
// Jalur pengukuran murni tetap: analogRead(GPIO4) + LO+/LO- -> Pan-Tompkins.
// Hanya scheduler yang diperbaiki: esp_timer memberi notifikasi setiap 5000 us.
// Callback timer TIDAK membaca ADC, TIDAK mengalokasi memori, TIDAK menggambar TFT.
// Producer membaca sekali per slot; jika terlalu lambat, slot ditandai hilang,
// bukan mengambil beberapa pembacaan palsu untuk mengejar waktu.
struct Sample {
  uint32_t ms;           // waktu nyata akuisisi (untuk RR/QRS)
  uint32_t slot;         // urutan timer 5ms (untuk indeks rekaman tanpa rounding)
  uint16_t adc;
  bool plus, minus;
};
constexpr uint16_t ECG_QUEUE_CAPACITY = 512;  // 2.56 detik penyangga @200 Hz
QueueHandle_t samples = nullptr;
TaskHandle_t acquisitionTask = nullptr;
esp_timer_handle_t acquisitionTimer = nullptr;


void ecgTimerNotify(void *) {
  // ESP_TIMER_TASK callback, bukan ISR; harus sesingkat mungkin.
  if (acquisitionTask) xTaskNotifyGive(acquisitionTask);
}


void readEcgSlot(uint32_t sampleMs, uint32_t slot) {
  Sample s = {
    sampleMs,
    slot,
    static_cast<uint16_t>(analogRead(PIN_ECG_OUT)),
    digitalRead(PIN_ECG_LO_PLUS) == HIGH,
    digitalRead(PIN_ECG_LO_MINUS) == HIGH
  };
  acquisitionLatestSlot = slot;
  ++acquisitionTotalReads;
  if (xQueueSend(samples, &s, 0) != pdTRUE) {
    ++acquisitionQueueDrops;
    ++sampleOverruns;
  }
}


void acquire(void *) {
  uint32_t slot = 0;
  for (;;) {
    const uint32_t pending = ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
    if (!pending) continue;
    // Bila beberapa tick sudah menumpuk, sampel tidak diulang dengan timestamp
    // berbeda tetapi ditandai sebagai slot yang memang tidak terbaca.
    if (pending > 1) {
      acquisitionMissedTicks += pending - 1;
      sampleOverruns += pending - 1;
    }
    slot += pending;
    // Gunakan millis() sebagai timestamp (wrap ~49 hari), bukan
    // micros()/1000 yang wrap setiap ~71 menit pada integer 32-bit.
    readEcgSlot(millis(), slot);
  }
}


// Sama persis ADC input/filter/QRS referensi, plus pencatatan slot yang valid.
// Parameter flat menjaga kompatibilitas auto-prototype Arduino IDE.
void sampleSensor(uint32_t nowMs, uint32_t slot, uint16_t adc, bool plus, bool minus) {
  latestProcessedSlot = slot;
  rawADC = (int)adc;
  modulePresent = true;
  loPlus = plus;
  loMinus = minus;


  adcMin = min(adcMin, rawADC);
  adcMax = max(adcMax, rawADC);
  if (prevRaw >= 0)
    adcDiffAvg += 0.003f * (fabsf((float)rawADC - prevRaw) - adcDiffAvg);
  prevRaw = rawADC;
  sampleCount++;


  // Indeks buffer menggunakan tick monontonik producer. Tidak ada benturan
  // indeks ketika millis() membulatkan atau jitter bernilai 1-4ms.
  if (activeWave && mode == RECORD) {
    // Jangan menulis sampel lama yang tertahan di antrean sebelum tombol ditekan.
    const int32_t signedIndex = (int32_t)(slot - recordBaseSlot);
    if (recordBaseValid && signedIndex >= 0 && signedIndex < (int32_t)TRACE_LEN) {
      const size_t index = (size_t)signedIndex;
      // Pertahankan bit penanda QRS jika puncak telah dicatat lebih awal.
      activeWave[index] = (adc & 0x0FFFu) | (activeWave[index] == NO_SAMPLE ? 0 : (activeWave[index] & QRS_MARK));
    }
  }


  const bool contactNow = !loPlus && !loMinus;
  if (contactNow != leadsContact) {
    leadsContact = contactNow;
    if (contactNow) leadContactSince = nowMs;
    resetPanTompkins();
  }


  if (!leadsContact) {
    dcTracker += 0.0125f * (rawADC - dcTracker);
    displaySignal = 0.96f * displaySignal + 0.04f * (rawADC - dcTracker);
    return;
  }
  panTompkins(rawADC, nowMs);
}


