void drawText(int x, int y, const String &s, uint16_t color, uint8_t size = 1, uint16_t paper = BLACK);
void drawText(int x, int y, const String &s, uint16_t color, uint8_t size, uint16_t paper) {
  const char *alphabets[] = { chars1, chars2, chars3, chars4 };
  const uint8_t *fonts[] = { font1, font2, font3, font4 };
  const char *alphabet = alphabets[size - 1];
  const int w = 6 * size, h = 8 * size;
  uint16_t palette[16];
  for (int i = 0; i < 16; ++i) palette[i] = blendPixel(paper, color, i);
  static uint16_t glyph[24 * 32];
  for (unsigned n = 0; n < s.length() && x + w <= WIDTH; ++n, x += w) {
    const char *entry = strchr(alphabet, s[n]);
    if (!entry) continue;
    const uint8_t *src = fonts[size - 1] + (entry - alphabet) * w * h / 2;
    for (int i = 0; i < w * h; i += 2) {
      uint8_t pair = pgm_read_byte(src++);
      glyph[i] = palette[pair >> 4];
      glyph[i + 1] = palette[pair & 15];
    }
    tft.drawRGBBitmap(x, y, glyph, w, h);
  }
}


enum UiField { RATE,
               RR_VALUE,
               CV_VALUE,
               UI_SIGNAL_STATUS,
               FOOT,
               FIELD_COUNT };
String previousField[FIELD_COUNT];
uint16_t previousColor[FIELD_COUNT];
int previousProgress = -1;


void field(int id, int x, int y, int w, int size, const String &value,
           uint16_t ink, uint16_t paper) {
  if (previousField[id] == value && previousColor[id] == ink) return;
  previousField[id] = value;
  previousColor[id] = ink;
  tft.fillRect(x, y, w, 8 * size, paper);
  drawText(x, y, value, ink, size, paper);
}


void drawStaticUI() {
  bool rec = mode == RECORD;
  uint16_t accent = rec ? RED : CYAN;
  uint16_t headerColor = rec ? BENCH_HEADER : NAVY;
  tft.fillScreen(BLACK);
  tft.fillRect(0, 0, WIDTH, 48, headerColor);
  if (rec) {
    constexpr char heading[] = "BENCHMARKING - ECG BOX";
    constexpr int textWidth = (sizeof(heading) - 1) * 18;
    static_assert(textWidth <= WIDTH, "Benchmark heading must fit the screen");
    drawText((WIDTH - textWidth) / 2, 12, heading, WHITE, 3, headerColor);
  } else {
    drawText(12, 12, "ECG BOX", WHITE, 3, NAVY);
    drawText(WIDTH - 12 - 16 * 12, 18, "REALTIME MONITOR", WHITE, 2, NAVY);
  }
  drawText(12, 56, "GELOMBANG ECG", MUTED, 2);
  drawText(PLOT_X + PLOT_W - 80, 57, "3s / AUTO", MUTED, 1);
  drawText(SIDE_X, 56, "DENYUT / BPM", accent);
  drawPlotGrid();
  tft.fillRoundRect(SIDE_X, SIDE_Y, SIDE_W, SIDE_H, 5, PANEL);
  tft.drawRoundRect(SIDE_X, SIDE_Y, SIDE_W, SIDE_H, 5, BORDER);
  tft.drawFastHLine(SIDE_X + 6, 138, SIDE_W - 12, BORDER);
  drawText(SIDE_X + 12, 151, "RR (ms)", MUTED, 1, PANEL);
  drawText(SIDE_X + 12, 204, "CV", MUTED, 1, PANEL);
  tft.fillRect(0, 268, WIDTH, HEIGHT - 268, PALE);
  tft.drawFastHLine(0, 267, WIDTH, accent);
  drawText(12, 277, "STATUS SINYAL", MUTED, 1, PALE);
  drawText(SIDE_X, 277, rec ? "SISA WAKTU" : "ADC RAW", accent, 1, PALE);
  for (int i = 0; i < FIELD_COUNT; ++i) previousField[i] = "";
  previousProgress = -1;
}


void drawDynamicUI() {
  uint32_t now = millis();
  // Tidak pernah kosongkan/reset grafik karena LO atau ADC invalid.
  bool checkModule = !modulePresent;
  const bool recent = lastQrsMs && now - lastQrsMs < 2800UL;
  const bool sufficientlyObserved = rrCount >= 3 && recent;
  const bool ready = leadsContact && now - leadContactSince >= 4500UL;
  const bool showHR = ready && sufficientlyObserved;
  portENTER_CRITICAL(&traceLock);
  webTrace[0] = uint8_t(mode);
  webTrace[1] = checkModule ? 3 : (leadsContact ? ((loPlus || loMinus) ? 4 : 1) : 2);
  webTrace[2] = showHR ? uint8_t(constrain(bpm, 0, 255)) : 0;
  webTrace[3] = PLOT_H;
  portEXIT_CRITICAL(&traceLock);
  const char *status = "MEMBACA RR";
  uint16_t ink = CYAN;
  if (checkModule) {
    status = "ADC TIDAK TERBACA";
    ink = YELLOW;
  } else if (loPlus || loMinus) {
    status = "ELEKTRODA GOYANG";
    ink = YELLOW;
  } else if (!leadsContact) {
    status = "LEADS OPEN";
    ink = YELLOW;
  } else if (!ready) {
    status = "STABILISASI";
    ink = YELLOW;
  } else if (showHR) {
    if (irregularFlag) {
      status = "RR BERVARIASI";
      ink = YELLOW;
    } else if (bpm < 60) {
      status = "BPM < 60";
      ink = YELLOW;
    } else if (bpm > 100) {
      status = "BPM > 100";
      ink = YELLOW;
    } else {
      status = "60-100 BPM";
      ink = MINT;
    }
  }
  field(RATE, SIDE_X + 12, 90, SIDE_W - 24, 4, showHR ? String(bpm) : "--", showHR ? MINT : MUTED, PANEL);
  field(RR_VALUE, SIDE_X + 12, 169, SIDE_W - 24, 2, showHR ? String(lastRR) : "--", TEXT, PANEL);
  field(CV_VALUE, SIDE_X + 12, 222, SIDE_W - 24, 2, showHR ? String(rrCV, 2) : "--", TEXT, PANEL);
  field(UI_SIGNAL_STATUS, 12, 296, 300, 2, status, ink, PALE);
  if (mode == RECORD) {
    uint32_t elapsed = min(uint32_t(now - sessionStart), SESSION_MS);
    unsigned seconds = (SESSION_MS - elapsed + 999) / 1000;
    char timer[8];
    snprintf(timer, sizeof(timer), "%02u:%02u", seconds / 60, seconds % 60);
    field(FOOT, SIDE_X, 296, SIDE_W, 2, timer, RED, PALE);
    int progress = elapsed * WIDTH / SESSION_MS;
    if (progress > previousProgress) {
      int start = max(previousProgress, 0);
      if (progress > start) tft.fillRect(start, 48, progress - start, 3, RED);
      previousProgress = progress;
    }
  } else {
    field(FOOT, SIDE_X, 296, SIDE_W, 2, modulePresent ? String(rawADC) : String("--"), TEXT, PALE);
  }
}


// Tombol merah dan biru aktif LOW. Tombol hijau NO langsung antara EN/RST
// ESP32-S3 dan GND agar reset juga berfungsi saat firmware tidak merespons.
constexpr int RED_KEY = 10, BLUE_KEY = 11;
bool pressed(int i) {
  const int pins[] = { RED_KEY, BLUE_KEY };
  static bool raw[2], stable[2];
  static uint32_t changed[2];
  bool down = digitalRead(pins[i]) == LOW;
  uint32_t now = millis();
  if (raw[i] != down) {
    raw[i] = down;
    changed[i] = now;
  }
  if (down == stable[i] || now - changed[i] < 30) return false;
  stable[i] = down;
  return down;
}
void buttons() {
  // Sesi 1 menit dapat dimulai tanpa memandang status LO atau elektroda.
  // Missing samples remain marked unavailable in the recording buffer.
  if (pressed(0)) {
    memset(covered, 0, sizeof(covered));
    memset(beatUnits, 0, sizeof(beatUnits));
    detectedBeats = 0;
    if (activeWave) memset(activeWave, 0xff, TRACE_LEN * sizeof(uint16_t));
    sessionStart = millis();
    recordBaseMs = sessionStart;
    // Mulai dari tick berikutnya, bukan sampel lama yang masih di antrean.
    recordBaseSlot = acquisitionLatestSlot + 1;
    recordBaseValid = true;
    mode = RECORD;
    redraw = true;
  }
  if (pressed(1)) {
    mode = MONITOR;
    redraw = true;
  }
}
void showResults() {
  portENTER_CRITICAL(&traceLock);
  webTrace[0] = uint8_t(RESULTS);
  portEXIT_CRITICAL(&traceLock);
  // Local quality rules: >=7 s of accepted RR per bin and >=5 valid bins.
  // Thresholds are engineering choices, not clinical acceptance criteria.
  tft.fillScreen(BLACK);
  tft.fillRect(0, 0, WIDTH, 48, BENCH_HEADER);
  drawText(12, 12, "HASIL SESI", WHITE, 3, BENCH_HEADER);
  drawText(SIDE_X, 16, "60 DETIK", WHITE, 2, BENCH_HEADER);
  float beats = 0;
  uint32_t span = 0;
  int valid = 0;
  float rate[BINS] = {};
  for (int i = 0; i < BINS; ++i) {
    if (covered[i] < 7000) continue;
    rate[i] = 60000.0f * beatUnits[i] / covered[i];
    ++valid;
    beats += beatUnits[i];
    span += covered[i];
  }
  drawText(12, 61, "BPM / 10 DETIK", CYAN, 2);
  for (int k = 0; k <= 4; ++k) {
    int y = 238 - k * 35;
    drawText(3, y - 3, String(k * 50), MUTED);
