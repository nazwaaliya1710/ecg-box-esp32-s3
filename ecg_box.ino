// Local-only dashboard. One NVS key per session slot; save once at session end.
// Konfigurasi sekali di firmware; tidak memerlukan Python/laptop pendamping.
// AP ECG-Box (192.168.4.1) tetap tersedia seperti sebelumnya.
constexpr char INTERNET_SSID[] = "[DISAMARKAN]";
constexpr char INTERNET_PASSWORD[] = "[DISAMARKAN]";
constexpr char GEMINI_API_KEY[] = "[DISAMARKAN]";
// Cloud: URL /exec setelah Apps Script di-deploy dan token yang sama di Code.gs.
constexpr char CLOUD_SCRIPT_URL[] = "[DISAMARKAN]";
constexpr char CLOUD_UPLOAD_TOKEN[] = "[DISAMARKAN]";
constexpr char GEMINI_MODEL[] = "gemini-3.5-flash-lite";  // Model cepat
// Fallback hanya dipakai apabila model utama sementara sibuk / tidak tersedia.
constexpr char GEMINI_FALLBACK_MODEL[] = "gemini-3.5-flash";  // Model cadangan
constexpr char AP_NAME[] = "ECG-Box", AP_PASSWORD[] = "ecgbox320";
struct BenchRecord {
  uint32_t id;
  uint16_t ms[BINS];
  float rate[BINS];
  int32_t qrs;     // -1 for a legacy summary without a measured count
  uint32_t label;  // 0 = belum diberi label
};
BenchRecord archive[SESSION_SLOTS] = {};
uint32_t newestId = 0;
String bootToken;


// Called with stateMutex held once the dashboard is online.
int findSessionSlot(uint32_t id) {
  for (int i = 0; i < SESSION_SLOTS; ++i)
    if (id && archive[i].id == id) return i;
  return -1;
}
int nextSessionSlot() {
  int oldest = 0;
  for (int i = 0; i < SESSION_SLOTS; ++i) {
    if (!archive[i].id) return i;
    if (archive[i].id < archive[oldest].id) oldest = i;
  }
  return oldest;
}
Preferences sessionStore;
WebServer dashboard(80);
SemaphoreHandle_t stateMutex = nullptr;
bool storeReady = false, lastSaved = true, dashboardOnline = false;
int recordedRemaining = -1;


void saveCompletedSession() {
  BenchRecord r = {};
  r.qrs = detectedBeats;
  if (stateMutex) xSemaphoreTake(stateMutex, portMAX_DELAY);
  r.id = newestId + 1;
  int slot = nextSessionSlot();
  for (int i = 0; i < BINS; ++i) {
    r.ms[i] = covered[i];
    if (covered[i] >= 7000) r.rate[i] = 60000.0f * beatUnits[i] / covered[i];
  }
  char key[12];
  snprintf(key, sizeof(key), "slot%d", slot);
  bool saved = storeReady && sessionStore.putBytes(key, &r, sizeof(r)) == sizeof(r);
  if (activeWave) {
    uint16_t *old = waveSlots[slot];
    waveSlots[slot] = activeWave;
    activeWave = old;
    waveIds[slot] = r.id;
  }
  archive[slot] = r;
  newestId = r.id;
  lastSaved = saved;
  if (stateMutex) xSemaphoreGive(stateMutex);
  if (!saved) Serial.println("ECG: session stored in RAM only");
}


void serveBenchmarks() {
  BenchRecord snapshot[SESSION_SLOTS];
  xSemaphoreTake(stateMutex, portMAX_DELAY);
  uint32_t traceIds[SESSION_SLOTS];
  memcpy(traceIds, waveIds, sizeof(traceIds));
  memcpy(snapshot, archive, sizeof(snapshot));
  int order[SESSION_SLOTS];
  for (int i = 0; i < SESSION_SLOTS; ++i) order[i] = i;
  int remaining = recordedRemaining;
  bool saved = lastSaved;
  xSemaphoreGive(stateMutex);
  String body;
  body.reserve(5400);
  body = "{\"boot\":\"";
  body += bootToken;
  body += "\",\"remaining\":";
  body += remaining < 0 ? String("null") : String(remaining);
  body += saved ? ",\"saved\":true,\"sessions\":[" : ",\"saved\":false,\"sessions\":[";
  bool separator = false;
  for (int i = 0; i < SESSION_SLOTS; ++i) {
    int newest = i;
    for (int j = i + 1; j < SESSION_SLOTS; ++j)
      if (snapshot[order[j]].id > snapshot[order[newest]].id) newest = j;
    int slot = order[newest];
    order[newest] = order[i];
    order[i] = slot;
    const BenchRecord &r = snapshot[slot];
    uint32_t id = r.id;
    if (!id) break;
    if (separator) body += ',';
    separator = true;
    body += "{\"id\":";
    body += id;
    body += ",\"label\":";
    body += r.label;
    body += ",\"qrs\":";
    body += r.qrs >= 0 ? String(r.qrs) : String("null");
    body += ",\"wave\":";
    body += traceIds[slot] == id ? "true" : "false";
    body += ",\"rows\":[";
    for (int j = 0; j < BINS; ++j) {
      if (j) body += ',';
      body += "{\"t\":";
      body += (j + 1) * 10;
      body += ",\"ms\":";
      body += r.ms[j];
      body += ",\"b\":";
      body += r.ms[j] >= 7000 ? String(r.rate[j], 2) : String("null");
      body += '}';
    }
    body += "]}";
  }
  body += "]}";
  dashboard.sendHeader("Cache-Control", "no-store");
  dashboard.send(200, "application/json", body);
}


// Each byte mirrors one TFT sweep column. Zero marks a cleared column.
// Header bytes are mode, electrode contact, displayed BPM, and plot height.
constexpr int WEB_TRACE_COLUMNS = PLOT_W - 8;
static_assert(PLOT_H <= 255, "TFT height per plot must fit the trace header");
uint8_t webTrace[4 + WEB_TRACE_COLUMNS] = {};
portMUX_TYPE traceLock = portMUX_INITIALIZER_UNLOCKED;


void serveTrace() {
  uint8_t frame[sizeof(webTrace)];
  portENTER_CRITICAL(&traceLock);
  memcpy(frame, webTrace, sizeof(frame));
  portEXIT_CRITICAL(&traceLock);
  dashboard.sendHeader("Cache-Control", "no-store");
  dashboard.send_P(200, "application/octet-stream",
                   reinterpret_cast<const char *>(frame), sizeof(frame));
}


void serveRecordedWave() {
  uint32_t id = strtoul(dashboard.arg("id").c_str(), nullptr, 10);
  if (!id) {
    dashboard.send(400, "text/plain", "Missing session ID");
    return;
  }
  size_t bytes = TRACE_LEN * sizeof(uint16_t);
  auto *copy = static_cast<uint16_t *>(heap_caps_malloc(bytes, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
  if (!copy) {
    dashboard.send(503, "text/plain", "PSRAM unavailable");
    return;
  }
  xSemaphoreTake(stateMutex, portMAX_DELAY);
  int slot = findSessionSlot(id);
  bool found = slot >= 0 && waveIds[slot] == id && waveSlots[slot];
  if (found) memcpy(copy, waveSlots[slot], bytes);
  xSemaphoreGive(stateMutex);
  dashboard.sendHeader("Cache-Control", "no-store");
  if (found) dashboard.send_P(200, "application/octet-stream", reinterpret_cast<const char *>(copy), bytes);
  else dashboard.send(404, "text/plain", "Waveform unavailable");
  heap_caps_free(copy);
}


void runDashboard(void *) {
  for (;;) {
    dashboard.handleClient();
    // pdMS_TO_TICKS(5) dapat bernilai 0 pada RTOS tick 100 Hz;
    // wajib tidur minimal satu tick agar task web tidak busy-spin.
    vTaskDelay(1);
  }
}


void saveSessionLabel() {
  if (dashboard.arg("boot") != bootToken) {
    dashboard.send(409, "text/plain", "Perangkat sudah dimulai ulang. Muat ulang riwayat.");
    return;
  }
  String raw = dashboard.arg("id"), value = dashboard.arg("label");
  uint32_t id = strtoul(raw.c_str(), nullptr, 10);
  if (!id || String(id) != raw || value.length() != 1 || value[0] < '0' || value[0] > '5') {
    dashboard.send(400, "text/plain", "ID atau label tidak valid.");
    return;
  }
  uint32_t label = value[0] - '0';
  xSemaphoreTake(stateMutex, portMAX_DELAY);
  int slot = findSessionSlot(id);
  bool ok = false;
  if (slot >= 0) {
    BenchRecord updated = archive[slot];
    updated.label = label;
    char key[12];
    snprintf(key, sizeof(key), "slot%d", slot);
    ok = storeReady && sessionStore.putBytes(key, &updated, sizeof(updated)) == sizeof(updated);
    if (ok) archive[slot] = updated;
  }
  xSemaphoreGive(stateMutex);
  if (slot < 0) dashboard.send(404, "text/plain", "Sesi sudah dihapus atau diganti.");
  else dashboard.send(ok ? 200 : 503, "text/plain", ok ? "OK" : "Label gagal disimpan.");
}
void deleteBenchmark() {
  if (dashboard.arg("boot") != bootToken) {
    dashboard.send(409, "text/plain", "Perangkat sudah dimulai ulang. Muat ulang riwayat.");
    return;
  }
  String raw = dashboard.arg("id");
  uint32_t id = strtoul(raw.c_str(), nullptr, 10);
  if (!id || String(id) != raw) {
    dashboard.send(400, "text/plain", "ID sesi tidak valid.");
    return;
  }
  xSemaphoreTake(stateMutex, portMAX_DELAY);
  int slot = findSessionSlot(id);
  bool ok = true;
  if (slot >= 0) {
    char key[12];
    snprintf(key, sizeof(key), "slot%d", slot);
    ok = storeReady && (!sessionStore.isKey(key) || sessionStore.remove(key));
    if (ok) {
      archive[slot] = {};
      waveIds[slot] = 0;
      if (waveSlots[slot]) memset(waveSlots[slot], 0xff, TRACE_LEN * sizeof(uint16_t));
    }
  }
  xSemaphoreGive(stateMutex);
  dashboard.send(ok ? 200 : 503, "text/plain", ok ? "OK" : "Gagal menghapus sesi dari penyimpanan.");
}


// ================= GEMINI LANGSUNG DARI ESP32 (hanya setelah benchmark) =================
// Mode cepat hanya mengubah RINGKASAN UNTUK AI dan konfigurasi HTTP/model.
// Buffer gelombang 200 Hz dan keseluruhan jalur ECG/BPM/TFT tidak berubah.
// Data yang dikirim: ringkasan BPM per interval dan envelope ADC setiap 100 ms (mode cepat).
// Sampling ECG2/Pan–Tompkins, TFT, benchmark, dan struktur arsip tidak berubah.
SemaphoreHandle_t aiMutex = nullptr;
uint8_t aiState = 0;  // 0=idle, 1=running, 2=done, 3=error
uint32_t aiSessionId = 0;
// Konteks sementara dari formulir dashboard untuk Gemini; tidak mengubah data ECG.
uint8_t aiPatientAge = 0;       // tahun, 1..120
uint8_t aiPatientSex = 0;       // 0=tidak dicantumkan, 1=laki-laki, 2=perempuan
uint8_t aiPatientActivity = 0;  // 1=istirahat, 2=berjalan, 3=olahraga, 4=lainnya
String aiResult, aiError, aiProgress;


String geminiJsonEscape(const String &value) {
  String out;
  out.reserve(value.length() + 64);
  for (size_t i = 0; i < value.length(); ++i) {
    char c = value[i];
    if (c == '"' || c == '\\') {
      out += '\\';
      out += c;
    } else if (c == '\n') out += "\\n";
    else if (c == '\r') out += "\\r";
    else if (c == '\t') out += "\\t";
    else if (static_cast<uint8_t>(c) >= 32) out += c;
  }
  return out;
}
// Ambil nilai string JSON di respons Gemini, termasuk escape newline / unicode sederhana.
String geminiParseText(const String &json, const char *field) {
  String token = String('"') + field + '"';
  int pos = json.indexOf(token);
  if (pos < 0) return String();
  pos = json.indexOf(':', pos + token.length());
  if (pos < 0) return String();
  ++pos;
  while (pos < (int)json.length() && (json[pos] == ' ' || json[pos] == '\r' || json[pos] == '\n')) ++pos;
  if (pos >= (int)json.length() || json[pos] != '"') return String();
  ++pos;
  String out;
  out.reserve(2400);
  for (; pos < (int)json.length(); ++pos) {
    char c = json[pos];
    if (c == '"') return out;
    if (c != '\\') {
      out += c;
      continue;
    }
    if (++pos >= (int)json.length()) break;
    char e = json[pos];
    if (e == 'n') out += '\n';
    else if (e == 'r') out += '\r';
    else if (e == 't') out += '\t';
    else if (e == 'b') out += ' ';
    else if (e == 'f') out += ' ';
    else if (e == 'u' && pos + 4 < (int)json.length()) {
      int value = 0;
      bool ok = true;
      for (int j = 1; j <= 4; j++) {
        char h = json[pos + j];
        int d = h >= '0' && h <= '9' ? h - '0' : h >= 'a' && h <= 'f' ? h - 'a' + 10
                                               : h >= 'A' && h <= 'F' ? h - 'A' + 10
                                                                      : -1;
        if (d < 0) {
          ok = false;
          break;
        }
        value = (value << 4) | d;
      }
      if (ok) {
        pos += 4;
        if (value < 0x80) out += (char)value;
        else if (value < 0x800) {
          out += (char)(0xC0 | (value >> 6));
          out += (char)(0x80 | (value & 0x3F));
        } else {
          out += (char)(0xE0 | (value >> 12));
          out += (char)(0x80 | ((value >> 6) & 0x3F));
          out += (char)(0x80 | (value & 0x3F));
        }
      }
    } else out += e;
  }
  return out;
}
void aiComplete(uint8_t finalState, const String &message) {
  xSemaphoreTake(aiMutex, portMAX_DELAY);
  aiState = finalState;
  aiProgress = "";
  if (finalState == 2) {
    aiResult = message;
    aiError = "";
  } else {
    aiError = message;
    aiResult = "";
  }
  xSemaphoreGive(aiMutex);
}
void aiSetProgress(const String &message) {
  if (!aiMutex) return;
  xSemaphoreTake(aiMutex, portMAX_DELAY);
  if (aiState == 1) aiProgress = message;
  xSemaphoreGive(aiMutex);
}


// Full stored recording -> JSON text in PSRAM. No downsampling or DSP changes.
uint8_t *buildFullWaveAiPayload(const String &escapedPrompt, const uint16_t *wave, size_t count, size_t &payloadSize) {
  payloadSize = 0;
  if (!wave || count != TRACE_LEN) return nullptr;
  const size_t capacity = escapedPrompt.length() + count * 20 + 2048;
  auto *data = static_cast<uint8_t *>(heap_caps_malloc(capacity, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
  if (!data) return nullptr;
  size_t used = 0; bool valid = true;
  auto append = [&](const char *text) {
    if (!valid) return;
    const size_t length = strlen(text);
    if (length >= capacity - used) { valid = false; return; }
    memcpy(data + used, text, length); used += length;
  };
  auto number = [&](unsigned value) { char buffer[16]; snprintf(buffer, sizeof(buffer), "%u", value); append(buffer); };
  append("{\"contents\":[{\"parts\":[{\"text\":\"");
  append(escapedPrompt.c_str());
  append("\\nREKAMAN LENGKAP: fs_hz=200; dt_ms=5; duration_ms=60000; sample_count="); number(count);
  append("; ADC[i] pada waktu i*5 ms, null=sampel hilang, unit=ADC bukan mV. Tidak ada downsampling.\\nADC=[");
  unsigned missing = 0;
  for (size_t i=0; i<count; ++i) {
    if (i) append(",");
    if (wave[i] == NO_SAMPLE) { append("null"); ++missing; }
    else number(wave[i] & 4095);
  }
  append("]\\nQRS_sample_index=["); bool first = true;
  for (size_t i=0; i<count; ++i) if (wave[i] != NO_SAMPLE && (wave[i] & QRS_MARK)) {
    if (!first) append(","); number(i); first = false;
  }
  append("]\\nRR_ms=["); int previous = -1; first = true;
  for (size_t i=0; i<count; ++i) if (wave[i] != NO_SAMPLE && (wave[i] & QRS_MARK)) {
    if (previous >= 0) { if (!first) append(","); number((i-previous)*5); first=false; }
    previous = static_cast<int>(i);
  }
  append("]\\nmissing_samples="); number(missing);
  append(". QRS/RR adalah penanda algoritma prototipe, bukan anotasi klinis.\\n");
  append("\"}]}],\"generationConfig\":{\"temperature\":0.2,\"maxOutputTokens\":4800,\"thinkingConfig\":{\"thinkingLevel\":\"MINIMAL\"}}}");
  if (!valid) { heap_caps_free(data); return nullptr; }
  data[used] = 0;
  payloadSize = used;
  return data;
}


void geminiWorker(void *arg) {
  uint32_t wanted = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(arg));
  uint8_t contextAge, contextSex, contextActivity;
  xSemaphoreTake(aiMutex, portMAX_DELAY);
  contextAge = aiPatientAge;
  contextSex = aiPatientSex;
  contextActivity = aiPatientActivity;
  xSemaphoreGive(aiMutex);
  BenchRecord session = {};
  const size_t waveBytes = TRACE_LEN * sizeof(uint16_t);
  auto *wave = static_cast<uint16_t *>(heap_caps_malloc(waveBytes, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
  if (!wave) {
    aiComplete(3, "PSRAM tidak cukup untuk analisis gelombang.");
    vTaskDelete(nullptr);
    return;
  }
  xSemaphoreTake(stateMutex, portMAX_DELAY);
  int slot = findSessionSlot(wanted);
  bool exists = slot >= 0 && waveSlots[slot] && waveIds[slot] == wanted;
  if (exists) {
    session = archive[slot];
    memcpy(wave, waveSlots[slot], waveBytes);
  }
  xSemaphoreGive(stateMutex);
  if (!exists) {
    heap_caps_free(wave);
    aiComplete(3, "Rekaman sesi tidak tersedia. Jalankan benchmark lagi.");
    vTaskDelete(nullptr);
    return;
  }
  if (WiFi.status() != WL_CONNECTED) {
    heap_caps_free(wave);
    aiComplete(3, "ESP32 belum terhubung ke Wi-Fi internet (STA).");
    vTaskDelete(nullptr);
    return;
  }
  if (strlen(GEMINI_API_KEY) < 20 || strncmp(GEMINI_API_KEY, "ISI_", 4) == 0) {
    heap_caps_free(wave);
    aiComplete(3, "Isi GEMINI_API_KEY pada firmware.");
    vTaskDelete(nullptr);
    return;
  }
  String prompt;
  prompt.reserve(16000);
  prompt = F("Anda adalah asisten interpretasi ECG pendahuluan untuk pendidikan ECG BOX. Tinjau SELURUH 12000 sampel ADC berurutan pada 200 Hz selama 60 detik, bukan envelope atau cuplikan. Sertakan statistik BPM/QRS/RR dan konteks pasien. Periksa awal, tengah dan akhir serta semua kejadian yang didukung data; jangan mengklaim bagian yang tidak berhasil dinilai. Ini bukan sistem diagnosis klinis tervalidasi.\n");
  prompt += F("Baris pertama tepat ECG_LABEL: KODE atau ECG_LABEL: KODE1,KODE2,KODE3 (maksimal 3 temuan yang paling didukung, terpenting dahulu). Kode tersedia: NORMAL,SINUS,TAKIKARDIA,BRADIKARDIA,ARITMIA,AFIB,FLUTTER_ATRIUM,EKSTRASISTOL,PAC,PVC,SVT,VT,BLOK_AV,BLOK_AV_1,BLOK_AV_2,BLOK_AV_3,BLOK_CABANG,WPW,PERUBAHAN_ST_T,ELEVASI_ST,DEPRESI_ST,INVERSI_T,GELOMBANG_Q,INFARK_AKUT,ISKEMIA,INFARK_LAMA,HIPERTROFI,PEMBESARAN_ATRIUM,KELAINAN_P,QRS_ABNORMAL,QT_PANJANG,QT_PENDEK,GANGGUAN_ELEKTROLIT,HIPERKALEMIA,HIPOKALEMIA,GANGGUAN_KALSIUM,EFEK_OBAT,NOISE,BELUM_PASTI. Semua kode kondisi berarti DUGAAN, bukan diagnosis pasti. NORMAL hanya berarti BPM sesuai acuan usia/aktivitas, bukan seluruh jantung normal; gunakan sendiri. Pilih NOISE atau BELUM_PASTI bila bukti tidak memadai. Jangan mengeluarkan semua label karena diminta meninjau semua kategori.\n");
  prompt += F("Setelah label, mulai ### Kesimpulan Utama. Buat kesimpulan lengkap: laju denyut, irama/RR, bentuk gelombang, kualitas data, dugaan utama beserta bukti/segmen waktu dan batas kepastian. Lanjutkan ### 1. Kualitas dan kelengkapan rekaman, ### 2. Irama dan konduksi, ### 3. ST-T dan aliran darah, ### 4. Struktur dan amplitudo, ### 5. Elektrolit dan efek obat, ### 6. Penilaian terpadu dan tindak lanjut, ### Disclaimer medis. Sekitar 800-1200 kata, paragraf pendek/bullet dan bold. Jangan gunakan tabel Markdown, HTML atau code fence.\n");
  prompt += F("Tinjau kategori irama: takikardia/bradikardia sesuai usia/aktivitas, irama sinus, AFib/flutter, kontraksi prematur PAC/PVC, SVT/VT; konduksi: hubungan P-QRS, kemungkinan blok AV/cabang, pra-eksitasi/WPW. Jangan simpulkan AFib dari variasi RR saja, atau sinus tanpa P konsisten yang dapat dinilai. Pertimbangkan miss/false QRS, gerakan dan kontak elektroda sebagai penjelasan alternatif. Nyatakan tidak dapat dinilai bila P atau bentuk QRS tidak jelas.\n");
  prompt += F("Tinjau perubahan ST/T/Q yang bisa mengarah pada iskemia/infark akut atau lama, kelainan P/QRS yang relevan bagi hipertrofi/pembesaran ruang, perubahan QT/T yang relevan bagi elektrolit/efek obat. Bedakan temuan bentuk dari penyebabnya. Rekaman satu lead tanpa kalibrasi, orientasi lead, karakteristik filter dan konteks klinis cukup TIDAK dapat memastikan/menyingkirkan STEMI, iskemia, infark lama, hipertrofi, pembesaran ruang, gangguan elektrolit atau keracunan obat. Untuk kategori tersebut, pilih label temuan seperti PERUBAHAN_ST_T/KELAINAN_P/QRS_ABNORMAL bila memang tampak; gunakan label penyakit hanya jika bukti yang disediakan memadai, bukan karena temuan tunggal yang tidak spesifik. T tinggi tidak membuktikan hiperkalemia; QRS tinggi dalam ADC tidak membuktikan hipertrofi; QT saja tidak membuktikan efek obat. Bila data pendukung tidak tersedia, tulis penyebab belum dapat ditentukan dan pemeriksaan konfirmasi yang relevan.\n");
  prompt += F("Data adalah ADC 0..4095 dari AD8232 satu lead, bukan mV terkalibrasi dan bukan ECG 12-lead. Filter analog dapat mendistorsi ST/morfologi. Tidak diketahui lead anatomi, gain/filter rinci, obat, hasil lab atau gejala. null berarti sampel hilang: jangan menggantinya dengan nol, menginterpolasi diam-diam, atau menganggapnya jeda jantung. Waktu sampel i adalah i*5 ms. Indeks QRS dan RR disertakan dari Pan–Tompkins sebagai deteksi prototipe, bukan anotasi klinis. Jangan mengarang PR/QRS/QT/QTc, amplitudo mV atau probabilitas penyakit; jangan mengaku melakukan pengukuran presisi yang tidak dilakukan. Bukti/segmen waktu harus cocok dengan sampel. Tidak adanya temuan bukan bukti bebas penyakit.\n");
  prompt += F("Disclaimer wajib: interpretasi AI pendahuluan dari prototipe satu lead untuk pendidikan; bukan diagnosis terkonfirmasi atau pengganti tenaga kesehatan. Rekomendasikan ECG klinis 12-lead, evaluasi dokter dan tes penunjang sesuai pertanyaan yang belum terjawab. Bila ada dugaan temuan serius, sarankan verifikasi segera secara proporsional; tanda bahaya disebut bersyarat tanpa menganggap pengguna mengalaminya. Jangan memberikan terapi/obat.\n");
  // Konteks demografis/aktivitas hanya untuk interpretasi, tidak dimasukkan ke DSP.
  prompt += F("Konteks yang dilaporkan pengguna: usia ");
  prompt += String(contextAge);
  prompt += F(" tahun; jenis kelamin biologis: ");
  prompt += (contextSex == 1 ? "laki-laki" : contextSex == 2 ? "perempuan"
                                                             : "tidak dicantumkan");
  prompt += F("; aktivitas sebelum pengukuran: ");
  prompt += (contextActivity == 1 ? "istirahat" : contextActivity == 2 ? "setelah berjalan"
                                                : contextActivity == 3 ? "setelah olahraga"
                                                                       : "lainnya / tidak diketahui");
  prompt += F(". Gunakan sebagai konteks untuk penilaian angka BPM dan kemungkinan interpretasi/diagnosis banding, tanpa mengubah angka pengukuran atau ambang algoritma.\n");
  prompt += F("ID sesi: ");
  prompt += wanted;
  prompt += F(". Jumlah QRS yang dideteksi algoritma Pan-Tompkins: ");
  prompt += session.qrs;
  prompt += '\n';
  prompt += F("BPM tiap interval 10 detik: ");
  float sum = 0;
  int n = 0;
  for (int i = 0; i < BINS; i++) {
    if (i) prompt += F(" | ");
    prompt += String(i * 10);
    prompt += '-';
    prompt += String((i + 1) * 10);
    prompt += F(" s: ");
    if (session.ms[i] >= 7000) {
      prompt += String(session.rate[i], 1);
      sum += session.rate[i];
      n++;
    } else prompt += F("tidak valid");
    prompt += F(" bpm (cakupan RR ");
    prompt += session.ms[i];
    prompt += F(" ms)");
  }
  prompt += F("\nRerata BPM interval valid: ");
  if (n) prompt += String(sum / n, 1);
  else prompt += F("tidak tersedia");
  prompt += F(". Cakupan interval valid: ");
  prompt += n;
  prompt += F("/6.\n");
  aiSetProgress("Menyusun seluruh 12.000 sampel (200 Hz / 60 detik), indeks QRS dan interval RR...");
  size_t payloadSize = 0;
  uint8_t *payload = buildFullWaveAiPayload(geminiJsonEscape(prompt), wave, TRACE_LEN, payloadSize);
  heap_caps_free(wave);
  prompt = String();
  if (!payload) {
    aiComplete(3, "PSRAM tidak cukup untuk paket rekaman lengkap. Tidak ada sampel yang dipotong atau dikurangi.");
    vTaskDelete(nullptr);
    return;
  }
  // Semua retry berjalan pada task AI, bukan pada task akuisisi ECG.
  // Mode cepat: hanya satu panggilan model utama, lalu satu fallback jika server sibuk.
  bool completed = false, canFallback = false, permanentError = false;
  String lastError = "Gemini gagal memberikan respons.";
  for (int modelIndex = 0; modelIndex < 2 && !completed && !permanentError; ++modelIndex) {
    if (modelIndex == 1 && !canFallback) break;
    const char *model = modelIndex == 0 ? GEMINI_MODEL : GEMINI_FALLBACK_MODEL;
    const int maxAttempts = 1;
    canFallback = false;
    for (int attempt = 0; attempt < maxAttempts && !completed && !permanentError; ++attempt) {
      if (WiFi.status() != WL_CONNECTED) {
        lastError = "Koneksi hotspot internet ESP32 terputus selama analisis.";
        permanentError = true;
        break;
      }
      aiSetProgress(String("Menghubungi ") + model + " (percobaan " + String(attempt + 1) + "/" + String(maxAttempts) + ")...");
      WiFiClientSecure client;
      client.setInsecure();  // Prototipe kampus; jalur HTTPS tetap terenkripsi.
      HTTPClient http;
      const String url = String(F("https://generativelanguage.googleapis.com/v1beta/models/")) + model + F(":generateContent");
      http.setConnectTimeout(8000);
      http.setTimeout(60000);
      if (!http.begin(client, url)) {
        lastError = "Tidak dapat membuka koneksi HTTPS Gemini.";
        permanentError = true;
        break;
      }
      http.addHeader("Content-Type", "application/json");
      http.addHeader("x-goog-api-key", GEMINI_API_KEY);
      const uint32_t callStartMs = millis();
      int status = http.POST(payload, payloadSize);
      String response = http.getString();
      http.end();
      Serial.printf("Gemini FULL12000 model=%s HTTP=%d durasi=%lu ms payload=%u bytes\n",
                    model, status, (unsigned long)(millis() - callStartMs), (unsigned)payloadSize);
      if (status == 200) {
        String result = geminiParseText(response, "text");
        if (result.length() == 0) {
          lastError = "Respons Gemini kosong. Ulangi analisis beberapa saat lagi.";
          permanentError = true;
        } else {
          aiComplete(2, result);
          completed = true;
        }
        break;
      }
      String detail = geminiParseText(response, "message");
      if (detail.length() > 180) detail = detail.substring(0, 180);
      lastError = String("Gemini HTTP ") + status;
      if (!detail.isEmpty()) {
        lastError += " - ";
        lastError += detail;
      }
      // 429 dibedakan dari 503: kemungkinan batas permintaan atau kuota.
      if (status == 429) {
        lastError = "Gemini HTTP 429: batas permintaan/kuota API. Coba setelah limit pulih.";
        permanentError = true;
        break;
      }
      // 401/403 dan 400 bukan kondisi sibuk; tidak di-retry atau fallback.
      if (status == 400 || status == 401 || status == 403) {
        permanentError = true;
        break;
      }
      const bool transient = (status == 500 || status == 502 || status == 503 || status == 504 || status == -11);
      if (!transient && status != 404) {
        permanentError = true;
        break;
      }
      canFallback = (status == 503 || status == 500 || status == 502 || status == 504 || status == 404);
      if (status == 404) break;  // Model utama tidak tersedia: coba model cadangan.
      // Tidak menunggu retry panjang; langsung coba model cadangan jika layak.
    }
  }
  heap_caps_free(payload);
  if (!completed) {
    if (lastError.indexOf("HTTP 503") >= 0) {
      lastError = "Gemini sedang penuh (503), termasuk setelah retry/model cadangan. Coba kembali beberapa menit lagi.";
    }
    aiComplete(3, lastError);
  }
  vTaskDelete(nullptr);
}


volatile bool cloudUploadRunning = false;
void startAiAnalysis() {
  if (mode == RECORD || recordedRemaining >= 0) {
    dashboard.send(409, "application/json", "{\"error\":\"Tunggu benchmark 60 detik selesai sebelum Analisa Gemini.\"}");
    return;
  }
  if (cloudUploadRunning) {
    dashboard.send(409, "application/json", "{\"error\":\"Upload cloud sedang berlangsung. Coba Gemini setelah upload selesai.\"}");
    return;
  }
  // Validasi konteks dari browser sebelum membuat task AI, tanpa menyimpannya ke NVS.
  String ageRaw = dashboard.arg("age");
  int age = ageRaw.toInt();
  if (age < 1 || age > 120 || String(age) != ageRaw) {
    dashboard.send(400, "application/json", "{\"error\":\"Usia pasien harus bilangan bulat antara 1 dan 120.\"}");
    return;
  }
  String sexRaw = dashboard.arg("sex");
  if (sexRaw != "" && sexRaw != "male" && sexRaw != "female") {
    dashboard.send(400, "application/json", "{\"error\":\"Jenis kelamin biologis tidak valid.\"}");
    return;
  }
  String activityRaw = dashboard.arg("activity");
  if (activityRaw != "rest" && activityRaw != "walking" && activityRaw != "exercise" && activityRaw != "other") {
    dashboard.send(400, "application/json", "{\"error\":\"Pilih aktivitas sebelum pengukuran.\"}");
    return;
  }
  const uint8_t sexCode = sexRaw == "male" ? 1 : (sexRaw == "female" ? 2 : 0);
  const uint8_t activityCode = activityRaw == "rest" ? 1 : (activityRaw == "walking" ? 2 : (activityRaw == "exercise" ? 3 : 4));
  String raw = dashboard.arg("id");
  uint32_t id = strtoul(raw.c_str(), nullptr, 10);
  if (!id || String(id) != raw || dashboard.arg("boot") != bootToken) {
    dashboard.send(400, "application/json", "{\"error\":\"Sesi atau token boot tidak valid. Refresh dashboard.\"}");
    return;
  }
  if (WiFi.status() != WL_CONNECTED) {
    dashboard.send(503, "application/json", "{\"error\":\"ESP32 belum tersambung hotspot internet. Cek SSID/password.\"}");
    return;
  }
  if (strncmp(GEMINI_API_KEY, "ISI_", 4) == 0) {
    dashboard.send(503, "application/json", "{\"error\":\"Isi GEMINI_API_KEY di firmware terlebih dahulu.\"}");
    return;
  }
  xSemaphoreTake(stateMutex, portMAX_DELAY);
  int slot = findSessionSlot(id);
  bool exists = slot >= 0 && waveIds[slot] == id && waveSlots[slot];
  xSemaphoreGive(stateMutex);
  if (!exists) {
    dashboard.send(404, "application/json", "{\"error\":\"Rekaman benchmark 60 detik tidak tersedia.\"}");
    return;
  }
  xSemaphoreTake(aiMutex, portMAX_DELAY);
  bool busy = aiState == 1;
  if (!busy) {
    aiState = 1;
    aiSessionId = id;
    aiPatientAge = static_cast<uint8_t>(age);
    aiPatientSex = sexCode;
    aiPatientActivity = activityCode;
    aiResult = "";
    aiError = "";
    aiProgress = "Menyiapkan data ECG...";
  }
  xSemaphoreGive(aiMutex);
  if (busy) {
    dashboard.send(409, "application/json", "{\"error\":\"Gemini sedang menganalisis sesi lain.\"}");
    return;
  }
  // WiFi/TLS pada Core 0 prioritas rendah; ADC pada Core 1 prioritas 4.
  BaseType_t started = xTaskCreatePinnedToCore(geminiWorker, "ecg_gemini", 12288, reinterpret_cast<void *>(static_cast<uintptr_t>(id)), 1, nullptr, 0);
  if (started != pdPASS) {
    aiComplete(3, "Gagal membuat task Gemini.");
    dashboard.send(503, "application/json", "{\"error\":\"Memori task AI tidak mencukupi.\"}");
    return;
  }
  dashboard.sendHeader("Cache-Control", "no-store");
  dashboard.send(202, "application/json", String("{\"started\":true,\"session_id\":") + id + '}');
}
void serveAiStatus() {
  uint8_t state;
  uint32_t id;
  String answer, error, progress;
  xSemaphoreTake(aiMutex, portMAX_DELAY);
  state = aiState;
  id = aiSessionId;
  answer = aiResult;
  error = aiError;
  progress = aiProgress;
  xSemaphoreGive(aiMutex);
  String body;
  body.reserve(answer.length() + error.length() + 100);
  body = F("{\"session_id\":");
  body += id;
  body += F(",\"state\":\"");
  body += (state == 1 ? "running" : state == 2 ? "done"
                                  : state == 3 ? "error"
                                               : "idle");
  body += '"';
  if (state == 2) {
    body += F(",\"analysis\":\"");
    body += geminiJsonEscape(answer);
    body += '"';
  }
  if (state == 3) {
    body += F(",\"error\":\"");
    body += geminiJsonEscape(error);
    body += '"';
  }
  if (state == 1) {
    body += F(",\"progress\":\"");
    body += geminiJsonEscape(progress);
    body += '"';
  }
  body += '}';
  dashboard.sendHeader("Cache-Control", "no-store");
  dashboard.send(200, "application/json", body);
}


// ================= GOOGLE DRIVE + GOOGLE SHEETS (POST-ASSEMBLY ONLY) =================
// Google Apps Script Web App (execute as owner). Upload 12.000 sample asli
// bertanda QRS; Google Sheet hanya berisi statistik + link CSV di Drive.
// Task asynchronous: TIDAK memanggil analogRead(), panTompkins(), atau fungsi TFT.
SemaphoreHandle_t cloudMutex = nullptr;
uint8_t cloudState = 0;  // 0 idle, 1 uploading, 2 done, 3 failed
uint32_t cloudSessionId = 0;
String cloudProgress, cloudMessage, cloudFolderUrl, cloudSheetUrl, cloudCsvUrl, cloudPdfUrl;
struct CloudPatient {
  uint32_t id;
  char name[96];
  uint8_t age, sex, activity;
};
CloudPatient cloudPatient = {};
// Staging is PSRAM-only. Dashboard sends small chunks; acquisition is unchanged.
char *cloudPdfData = nullptr;
size_t cloudPdfSize = 0, cloudPdfReceived = 0;
uint32_t cloudPdfSession = 0;
String cloudPdfTicket;
void receiveCloudPdfBegin() {
  if (dashboard.arg("boot") != bootToken) { dashboard.send(409,"application/json","{\"error\":\"ESP32 restart. Refresh halaman.\"}"); return; }
  uint32_t id = strtoul(dashboard.arg("id").c_str(), nullptr, 10);
  size_t size = strtoul(dashboard.arg("size").c_str(), nullptr, 10);
  if (!id || size < 100 || size > 2000000 || size % 4) { dashboard.send(400,"application/json","{\"error\":\"Ukuran PDF tidak valid.\"}"); return; }
  xSemaphoreTake(cloudMutex, portMAX_DELAY);
  if (cloudUploadRunning) { xSemaphoreGive(cloudMutex); dashboard.send(409,"application/json","{\"error\":\"Upload cloud sedang berjalan.\"}"); return; }
  if (cloudPdfData) heap_caps_free(cloudPdfData);
  cloudPdfData = static_cast<char *>(heap_caps_malloc(size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
  cloudPdfSize = cloudPdfData ? size : 0; cloudPdfReceived = 0; cloudPdfSession = id;
  cloudPdfTicket = String(esp_random(), HEX) + String(esp_random(), HEX);
  String reply = cloudPdfData ? String("{\"ticket\":\"") + cloudPdfTicket + "\"}" : "{\"error\":\"PSRAM tidak cukup untuk PDF.\"}";
  bool ready = cloudPdfData != nullptr;
  xSemaphoreGive(cloudMutex);
  dashboard.send(ready ? 200 : 503,"application/json",reply);
}
void receiveCloudPdfChunk() {
  if (dashboard.arg("boot") != bootToken) { dashboard.send(409,"application/json","{\"error\":\"ESP32 restart. Refresh halaman.\"}"); return; }
  const String part = dashboard.arg("data");
  const size_t offset = strtoul(dashboard.arg("offset").c_str(), nullptr, 10);
  bool valid = part.length() && part.length() <= 8192;
  for (size_t i=0;valid && i<part.length();i++) { char c=part[i]; valid=(c>='A'&&c<='Z')||(c>='a'&&c<='z')||(c>='0'&&c<='9')||c=='+'||c=='/'||c=='='; }
  xSemaphoreTake(cloudMutex, portMAX_DELAY);
  valid = valid && !cloudUploadRunning && cloudPdfData && dashboard.arg("ticket")==cloudPdfTicket && dashboard.arg("id").toInt()==cloudPdfSession && offset==cloudPdfReceived && offset<=cloudPdfSize && part.length()<=cloudPdfSize-offset;
  if (valid) { memcpy(cloudPdfData+offset,part.c_str(),part.length()); cloudPdfReceived += part.length(); }
  xSemaphoreGive(cloudMutex);
  dashboard.send(valid ? 200 : 409,"application/json",valid ? "{\"ok\":true}" : "{\"error\":\"Urutan atau sesi transfer PDF tidak cocok. Ulangi upload.\"}");
}


void cloudStatusUpdate(const String &message) {
  if (!cloudMutex) return;
  xSemaphoreTake(cloudMutex, portMAX_DELAY);
  cloudProgress = message;
  xSemaphoreGive(cloudMutex);
}
void cloudFinish(uint8_t result, const String &message, const String &folder = "", const String &sheet = "", const String &csv = "", const String &pdf = "") {
  xSemaphoreTake(cloudMutex, portMAX_DELAY);
  cloudState = result;
  cloudUploadRunning = false;
  cloudMessage = message;
  cloudProgress = "";
  cloudFolderUrl = folder;
  cloudSheetUrl = sheet;
  cloudCsvUrl = csv;
  cloudPdfUrl = pdf;
  if (cloudPdfData) heap_caps_free(cloudPdfData);
  cloudPdfData = nullptr; cloudPdfSize = cloudPdfReceived = 0; cloudPdfTicket = "";
  xSemaphoreGive(cloudMutex);
}
bool checkCloudPrintLayout(String &error) {
  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.setConnectTimeout(10000);
  http.setTimeout(30000);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  if (!http.begin(client, CLOUD_SCRIPT_URL)) { error = "Tidak dapat memeriksa versi Apps Script."; return false; }
  int code = http.GET();
  String reply = http.getString();
  http.end();
  if (code != 200) { error = String("Pemeriksaan Apps Script HTTP ") + code + ". Periksa koneksi dan akses Web App."; return false; }
  if (geminiParseText(reply, "report_layout") != "ecgbox.print.v2") {
    error = "Apps Script masih versi layout lama. Deploy > Manage deployments > Edit > New version > Deploy pada URL yang sama, lalu upload ulang. PDF belum diunggah.";
    return false;
  }
  return true;
}
void cloudWorker(void *) {
  CloudPatient request;
  xSemaphoreTake(cloudMutex, portMAX_DELAY);
  request = cloudPatient;
  xSemaphoreGive(cloudMutex);
  uint32_t wanted = request.id;
  const size_t waveBytes = TRACE_LEN * sizeof(uint16_t);  // 24.000 byte
  auto *wave = static_cast<uint16_t *>(heap_caps_malloc(waveBytes, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
  if (!wave) {
    cloudFinish(3, "PSRAM tidak cukup untuk menyalin rekaman.");
    vTaskDelete(nullptr);
    return;
  }
  BenchRecord record = {};
  xSemaphoreTake(stateMutex, portMAX_DELAY);
  int slot = findSessionSlot(wanted);
  bool found = slot >= 0 && waveSlots[slot] && waveIds[slot] == wanted;
  if (found) {
    record = archive[slot];
    memcpy(wave, waveSlots[slot], waveBytes);
  }
  xSemaphoreGive(stateMutex);
  if (!found) {
    heap_caps_free(wave);
    cloudFinish(3, "Rekaman sesi tidak tersedia. Tidak dapat upload gelombang 60 detik.");
    vTaskDelete(nullptr);
    return;
  }
  if (WiFi.status() != WL_CONNECTED) {
    heap_caps_free(wave);
    cloudFinish(3, "ESP32 belum terhubung Wi-Fi internet.");
    vTaskDelete(nullptr);
    return;
  }
  cloudStatusUpdate("Memastikan Apps Script memakai layout Cetak Laporan...");
  String layoutError;
  if (!checkCloudPrintLayout(layoutError)) {
    heap_caps_free(wave);
    cloudFinish(3, layoutError);
    vTaskDelete(nullptr);
    return;
  }
  cloudStatusUpdate("Membuat paket data ECG dan ringkasan benchmark...");
  String sex = request.sex == 1 ? "male" : request.sex == 2 ? "female"
                                                            : "";
  String activity = request.activity == 1 ? "rest" : request.activity == 2 ? "walking"
                                                   : request.activity == 3 ? "exercise"
                                                                           : "other";
  String aiText;
  if (aiMutex) {
    xSemaphoreTake(aiMutex, portMAX_DELAY);
    if (aiState == 2 && aiSessionId == wanted) aiText = aiResult;
    xSemaphoreGive(aiMutex);
  }
  if (aiText.length() > 12000) aiText = aiText.substring(0, 12000);
  String prefix;
  prefix.reserve(1800);
  prefix = "{\"schema\":\"ecgbox.v1\",\"token\":\"";
  prefix += geminiJsonEscape(CLOUD_UPLOAD_TOKEN);
  prefix += "\",\"key\":\"";
  prefix += geminiJsonEscape(WiFi.macAddress() + ":" + String(wanted));
  prefix += "\",\"device\":\"";
  prefix += geminiJsonEscape(WiFi.macAddress());
  prefix += "\",\"id\":";
  prefix += String(wanted);
  prefix += ",\"fs\":200,\"samples\":12000,\"encoding\":\"u16le-base64\",\"patient\":{\"name\":\"";
  prefix += geminiJsonEscape(String(request.name));
  prefix += "\",\"age\":";
  prefix += String(request.age);
  prefix += ",\"sex\":\"";
  prefix += sex;
  prefix += "\",\"activity\":\"";
  prefix += activity;
  prefix += "\"},\"qrs\":";
  prefix += String(record.qrs);
  prefix += ",\"label\":";
  prefix += String(record.label);
  prefix += ",\"rows\":[";
  for (int i = 0; i < BINS; i++) {
    if (i) prefix += ',';
    prefix += "{\"t\":";
    prefix += String((i + 1) * 10);
    prefix += ",\"ms\":";
    prefix += String(record.ms[i]);
    prefix += ",\"b\":";
    prefix += (record.ms[i] >= 7000 ? String(record.rate[i], 2) : String("null"));
    prefix += '}';
  }
  prefix += "],\"ai\":\"";
  prefix += geminiJsonEscape(aiText);
  prefix += "\",\"raw\":\"";
  // JSON body dirakit di PSRAM agar 32 KB base64 tidak memenuhi heap internal.
  size_t capacity = prefix.length() + ((waveBytes + 2) / 3) * 4 + cloudPdfSize + 96;
  uint8_t *payload = static_cast<uint8_t *>(heap_caps_malloc(capacity, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
  if (!payload) {
    heap_caps_free(wave);
    cloudFinish(3, "PSRAM untuk paket upload tidak cukup.");
    vTaskDelete(nullptr);
    return;
  }
  memcpy(payload, prefix.c_str(), prefix.length());
  size_t encoded = 0;
  int ok = mbedtls_base64_encode(payload + prefix.length(), capacity - prefix.length() - 3, &encoded, reinterpret_cast<const unsigned char *>(wave), waveBytes);
  heap_caps_free(wave);
  if (ok != 0) {
    heap_caps_free(payload);
    cloudFinish(3, "Encoding base64 ECG gagal.");
    vTaskDelete(nullptr);
    return;
  }
  size_t bodySize = prefix.length() + encoded;
  payload[bodySize++] = '"';
  const char pdfField[] = ",\"report_layout\":\"ecgbox.print.v2\",\"print_pdf\":\"";
  memcpy(payload + bodySize, pdfField, sizeof(pdfField)-1); bodySize += sizeof(pdfField)-1;
  memcpy(payload + bodySize, cloudPdfData, cloudPdfSize); bodySize += cloudPdfSize;
  payload[bodySize++] = '"';
  payload[bodySize++] = '}';
  cloudStatusUpdate("Mengunggah 60 detik ECG ke Google Apps Script...");
  WiFiClientSecure client;
  client.setInsecure();  // Sesuai konfigurasi prototipe Gemini saat ini.
  HTTPClient http;
  http.setConnectTimeout(10000);
  http.setTimeout(60000);
  const char *headers[] = { "Location" };
  http.collectHeaders(headers, 1);
  if (!http.begin(client, CLOUD_SCRIPT_URL)) {
    heap_caps_free(payload);
    cloudFinish(3, "Tidak dapat membuka URL Google Apps Script.");
    vTaskDelete(nullptr);
    return;
  }
  http.addHeader("Content-Type", "application/json");
  int httpCode = http.POST(payload, bodySize);
  String response;
  String location;
  // ContentService mengembalikan HTTP 302 ke script.googleusercontent.com.
  if (httpCode == 302 || httpCode == 301 || httpCode == 303 || httpCode == 307) {
    location = http.header("Location");
  } else response = http.getString();
  http.end();
  heap_caps_free(payload);
  if (location.length() > 0) {
    cloudStatusUpdate("Memastikan hasil penyimpanan Google Drive dan Sheets...");
    if (!location.startsWith("https://")) {
      cloudFinish(3, "Google mengirim URL redirect yang tidak valid.");
      vTaskDelete(nullptr);
      return;
    }
    WiFiClientSecure followClient;
    followClient.setInsecure();
    HTTPClient follow;
    follow.setConnectTimeout(10000);
    follow.setTimeout(60000);
    if (follow.begin(followClient, location)) {
      httpCode = follow.GET();
      response = follow.getString();
      follow.end();
    } else {
      httpCode = -1;
    }
  }
  Serial.printf("ECG cloud upload HTTP=%d response=%u byte\n", httpCode, (unsigned)response.length());
  if (httpCode == 200 && response.indexOf("\"ok\":true") >= 0) {
    String folder = geminiParseText(response, "folder_url");
    String sheet = geminiParseText(response, "sheet_url");
    String csv = geminiParseText(response, "csv_url");
    String pdf = geminiParseText(response, "pdf_url");
    if (geminiParseText(response, "report_layout") != "ecgbox.print.v2") cloudFinish(3, "Apps Script tidak mengonfirmasi layout cetak. Perbarui deployment Web App ke versi terbaru.");
    else if (pdf.isEmpty()) cloudFinish(3, "CSV tersimpan, tetapi PDF belum tersedia. Perbarui deployment Apps Script lalu upload ulang sesi ini.");
    else cloudFinish(2, "Rekaman dan laporan PDF berhasil tersimpan di Google Drive dan Sheets.", folder, sheet, csv, pdf);
  } else {
    String message = geminiParseText(response, "error");
    if (message.isEmpty()) message = String("Google upload HTTP ") + String(httpCode) + ". Periksa deployment, koneksi internet dan izin Apps Script.";
    cloudFinish(3, message);
  }
  vTaskDelete(nullptr);
}
void startCloudUpload() {
  if (dashboard.arg("boot") != bootToken) {
    dashboard.send(409, "application/json", "{\"error\":\"ESP32 restart. Refresh halaman.\"}");
    return;
  }
  String raw = dashboard.arg("id"), name = dashboard.arg("name"), ageText = dashboard.arg("age");
  uint32_t id = strtoul(raw.c_str(), nullptr, 10);
  int age = ageText.toInt();
  if (!id || String(id) != raw || age < 1 || age > 120 || String(age) != ageText || name.isEmpty() || name.length() > 80) {
    dashboard.send(400, "application/json", "{\"error\":\"Sesi, nama, atau usia tidak valid.\"}");
    return;
  }
  String sex = dashboard.arg("sex"), activity = dashboard.arg("activity");
  if ((sex != "" && sex != "male" && sex != "female") || (activity != "rest" && activity != "walking" && activity != "exercise" && activity != "other")) {
    dashboard.send(400, "application/json", "{\"error\":\"Sex atau aktivitas tidak valid.\"}");
    return;
  }
  if (WiFi.status() != WL_CONNECTED) {
    dashboard.send(503, "application/json", "{\"error\":\"ESP32 belum mendapat internet dari router / hotspot.\"}");
    return;
  }
  if (String(CLOUD_SCRIPT_URL).indexOf("script.google.com/macros/s/") < 0 || String(CLOUD_SCRIPT_URL).indexOf("ISI_") >= 0 || String(CLOUD_UPLOAD_TOKEN).startsWith("ISI_")) {
    dashboard.send(503, "application/json", "{\"error\":\"Isi CLOUD_SCRIPT_URL dan CLOUD_UPLOAD_TOKEN di firmware sesuai Apps Script.\"}");
    return;
  }
  if (aiMutex) {
    xSemaphoreTake(aiMutex, portMAX_DELAY);
    bool aiBusy = aiState == 1;
    xSemaphoreGive(aiMutex);
    if (aiBusy) {
      dashboard.send(409, "application/json", "{\"error\":\"Tunggu Analisa Gemini selesai sebelum upload cloud.\"}");
      return;
    }
  }
  if (mode == RECORD || recordedRemaining >= 0) {
    dashboard.send(409, "application/json", "{\"error\":\"Tunggu benchmark berjalan selesai sebelum upload.\"}");
    return;
  }
  xSemaphoreTake(stateMutex, portMAX_DELAY);
  int slot = findSessionSlot(id);
  bool exists = slot >= 0 && waveSlots[slot] && waveIds[slot] == id;
  xSemaphoreGive(stateMutex);
  if (!exists) {
    dashboard.send(404, "application/json", "{\"error\":\"Gelombang sesi tidak tersedia di PSRAM.\"}");
    return;
  }
  if (!cloudMutex) {
    dashboard.send(503, "application/json", "{\"error\":\"Cloud task belum siap.\"}");
    return;
  }
  xSemaphoreTake(cloudMutex, portMAX_DELAY);
  bool busy = cloudState == 1;
  if (!busy && (!cloudPdfData || cloudPdfSession != id || cloudPdfReceived != cloudPdfSize || dashboard.arg("pdf_ticket") != cloudPdfTicket)) {
    xSemaphoreGive(cloudMutex);
    dashboard.send(409, "application/json", "{\"error\":\"PDF cetak belum lengkap. Refresh dashboard lalu upload ulang.\"}");
    return;
  }
  if (!busy) {
    cloudState = 1;
    cloudUploadRunning = true;
    cloudSessionId = id;
    cloudMessage = "";
    cloudProgress = "Menyiapkan upload...";
    cloudFolderUrl = "";
    cloudSheetUrl = "";
    cloudCsvUrl = "";
    cloudPdfUrl = "";
    memset(&cloudPatient, 0, sizeof(cloudPatient));
    cloudPatient.id = id;
    name.toCharArray(cloudPatient.name, sizeof(cloudPatient.name));
    cloudPatient.age = static_cast<uint8_t>(age);
    cloudPatient.sex = sex == "male" ? 1 : (sex == "female" ? 2 : 0);
    cloudPatient.activity = activity == "rest" ? 1 : (activity == "walking" ? 2 : (activity == "exercise" ? 3 : 4));
  }
  xSemaphoreGive(cloudMutex);
  if (busy) {
    dashboard.send(409, "application/json", "{\"error\":\"Upload sesi lain masih berlangsung.\"}");
    return;
  }
  // Upload juga dipisahkan dari Core 1 yang menggambar dan memproses ECG.
  BaseType_t created = xTaskCreatePinnedToCore(cloudWorker, "ecg_cloud", 12288, nullptr, 1, nullptr, 0);
  if (created != pdPASS) {
    cloudFinish(3, "Tidak cukup memori untuk task cloud.");
    dashboard.send(503, "application/json", "{\"error\":\"Task cloud gagal dibuat.\"}");
    return;
  }
  dashboard.sendHeader("Cache-Control", "no-store");
  dashboard.send(202, "application/json", String("{\"started\":true,\"session_id\":") + id + "}");
}
void serveCloudStatus() {
  if (!cloudMutex) {
    dashboard.send(503, "application/json", "{\"error\":\"Cloud belum siap\"}");
    return;
  }
  uint8_t state;
  uint32_t session;
  String msg, progress, folder, sheet, csv, pdf;
  xSemaphoreTake(cloudMutex, portMAX_DELAY);
  state = cloudState;
  session = cloudSessionId;
  msg = cloudMessage;
  progress = cloudProgress;
  folder = cloudFolderUrl;
  sheet = cloudSheetUrl;
  csv = cloudCsvUrl;
  pdf = cloudPdfUrl;
  xSemaphoreGive(cloudMutex);
  String out;
  out.reserve(500 + msg.length());
  out = "{\"session_id\":";
  out += String(session);
  out += ",\"state\":\"";
  out += (state == 1 ? "running" : state == 2 ? "done"
                                 : state == 3 ? "error"
                                              : "idle");
  out += '"';
  out += ",\"progress\":\"";
  out += geminiJsonEscape(progress);
  out += '"';
  out += ",\"message\":\"";
  out += geminiJsonEscape(msg);
  out += '"';
  if (state == 3) {
    out += ",\"error\":\"";
    out += geminiJsonEscape(msg);
    out += '"';
  }
  if (state == 2) {
    out += ",\"pdf_url\":\"";
    out += geminiJsonEscape(pdf);
    out += '"';
    out += ",\"folder_url\":\"";
    out += geminiJsonEscape(folder);
    out += '"';
    out += ",\"sheet_url\":\"";
    out += geminiJsonEscape(sheet);
    out += '"';
    out += ",\"csv_url\":\"";
    out += geminiJsonEscape(csv);
    out += '"';
  }
  out += '}';
  dashboard.sendHeader("Cache-Control", "no-store");
  dashboard.send(200, "application/json", out);
}


// ================= DIAGNOSTIK SISTEM (TERPISAH DARI AKUISISI) =================
// Estimasi CPU per core berdasarkan proporsi tick saat idle hook bisa berjalan.
// Bukan penggunaan cycles presisi. Callback dipanggil maks. sekali per tick,
// tidak melakukan I/O / blocking dan tidak mengubah task sampling ECG.
volatile uint32_t diagIdleTickCount0 = 0;
volatile uint32_t diagIdleTickCount1 = 0;
bool diagIdleHook0Ready = false, diagIdleHook1Ready = false;
float diagCpu0 = -1.0f, diagCpu1 = -1.0f;
volatile uint32_t diagLatestSamplesHz = 0;


bool IRAM_ATTR diagIdle0() {
  ++diagIdleTickCount0;
  return true;
}
bool IRAM_ATTR diagIdle1() {
  ++diagIdleTickCount1;
  return true;
}


void initDiagnostics() {
  diagIdleHook0Ready = esp_register_freertos_idle_hook_for_cpu(diagIdle0, 0) == ESP_OK;
  diagIdleHook1Ready = esp_register_freertos_idle_hook_for_cpu(diagIdle1, 1) == ESP_OK;
  Serial.printf("Diagnostics: idle hooks core0=%d core1=%d\\n", diagIdleHook0Ready, diagIdleHook1Ready);
}


void sampleDiagnosticCpu() {
  static uint32_t previousMs = 0, previous0 = 0, previous1 = 0;
  const uint32_t nowMs = millis();
  if (nowMs - previousMs < 1000) return;
  const uint32_t c0 = diagIdleTickCount0, c1 = diagIdleTickCount1;
  if (previousMs > 0) {
    const float expectedTicks = ((float)(nowMs - previousMs) * (float)configTICK_RATE_HZ) / 1000.0f;
    if (expectedTicks > 0.0f) {
      if (diagIdleHook0Ready) diagCpu0 = 100.0f * (1.0f - fminf(1.0f, (c0 - previous0) / expectedTicks));
      if (diagIdleHook1Ready) diagCpu1 = 100.0f * (1.0f - fminf(1.0f, (c1 - previous1) / expectedTicks));
    }
  }
  previousMs = nowMs;
  previous0 = c0;
  previous1 = c1;
}


void serveDiagnostics() {
  sampleDiagnosticCpu();
  const uint32_t internalTotal = heap_caps_get_total_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  const uint32_t internalFree = heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  const uint32_t internalMin = heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  const uint32_t internalLargest = heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  const uint32_t psramTotal = ESP.getPsramSize();
  const uint32_t psramFree = ESP.getFreePsram();
  const uint32_t appUsed = ESP.getSketchSize();
  const uint32_t appPartition = appUsed + ESP.getFreeSketchSpace();
  const bool staConnected = WiFi.status() == WL_CONNECTED;
  const uint32_t currentDepth = samples ? uxQueueMessagesWaiting(samples) : 0;
  const bool isRecording = recordedRemaining >= 0;
  String body;
  body.reserve(770);
  body = "{\"uptime_ms\":";
  body += String(millis());
  body += ",\"cpu\":{\"core0\":";
  body += diagCpu0 < 0 ? "null" : String(diagCpu0, 1);
  body += ",\"core1\":";
  body += diagCpu1 < 0 ? "null" : String(diagCpu1, 1);
  body += ",\"freq_mhz\":";
  body += String(ESP.getCpuFreqMHz());
  body += "}";
  body += ",\"mem\":{\"internal\":{\"total\":";
  body += String(internalTotal);
  body += ",\"free\":";
  body += String(internalFree);
  body += ",\"minimum_free\":";
  body += String(internalMin);
  body += ",\"largest_block\":";
  body += String(internalLargest);
  body += "},\"psram\":{\"total\":";
  body += String(psramTotal);
  body += ",\"free\":";
  body += String(psramFree);
  body += "}}";
  body += ",\"flash\":{\"chip_size\":";
  body += String(ESP.getFlashChipSize());
  body += ",\"sketch\":";
  body += String(appUsed);
  body += ",\"partition\":";
  body += String(appPartition);
  body += "}";
  body += ",\"ecg\":{\"samples_hz\":";
  body += String(diagLatestSamplesHz);
  body += ",\"overruns\":";
  body += String(sampleOverruns);
  body += ",\"queue_depth\":";
  body += String(currentDepth);
  body += ",\"queue_capacity\":";
  body += String(ECG_QUEUE_CAPACITY);
  body += ",\"timer_missed\":";
  body += String(acquisitionMissedTicks);
  body += ",\"queue_drops\":";
  body += String(acquisitionQueueDrops);
  body += ",\"adc_reads\":";
  body += String(acquisitionTotalReads);
  body += ",\"recording\":";
  body += isRecording ? "true" : "false";
  body += "}";
  body += ",\"wifi\":{\"connected\":";
  body += staConnected ? "true" : "false";
  body += ",\"rssi\":";
  body += staConnected ? String(WiFi.RSSI()) : "null";
  body += ",\"clients\":";
  body += String(WiFi.softAPgetStationNum());
  body += "}}";
  dashboard.sendHeader("Cache-Control", "no-store, max-age=0");
  dashboard.send(200, "application/json", body);
}


void startDashboard() {
  bootToken = String(esp_random(), HEX);
  storeReady = sessionStore.begin("ecgbench1", false);
  lastSaved = storeReady;
  if (storeReady) {
    for (int slot = 0; slot < SESSION_SLOTS; ++slot) {
      char key[12];
      snprintf(key, sizeof(key), "slot%d", slot);
      BenchRecord r = {};
      size_t len = sessionStore.getBytesLength(key);
      r.qrs = -1;
      if ((len == sizeof(r) || len == offsetof(BenchRecord, label) || len == offsetof(BenchRecord, qrs)) && sessionStore.getBytes(key, &r, len) == len && r.id) {
        archive[slot] = r;
        newestId = max(newestId, r.id);
      }
    }
  }
  stateMutex = xSemaphoreCreateMutex();
  IPAddress ip(192, 168, 4, 1);
  aiMutex = xSemaphoreCreateMutex();
  cloudMutex = xSemaphoreCreateMutex();
  if (!stateMutex || !aiMutex || !cloudMutex || !WiFi.mode(WIFI_AP_STA) || !WiFi.softAPConfig(ip, ip, IPAddress(255, 255, 255, 0)) || !WiFi.softAP(AP_NAME, AP_PASSWORD)) return;
  // STA connect secara asynchronous; AP ECG-Box tetap melayani dashboard.
  if (strncmp(INTERNET_SSID, "ISI_", 4) != 0 && strlen(INTERNET_SSID) > 0) {
    WiFi.setAutoReconnect(true);
    WiFi.begin(INTERNET_SSID, INTERNET_PASSWORD);
  }
  dashboard.on("/", HTTP_GET, []() {
    dashboard.sendHeader("Cache-Control", "no-store, max-age=0");  // Selalu ambil dashboard terbaru setelah firmware diperbarui
    dashboard.sendHeader("Content-Encoding", "gzip");
    dashboard.send_P(200, "text/html; charset=utf-8",
                     reinterpret_cast<const char *>(DASHBOARD_GZ), sizeof(DASHBOARD_GZ));
  });
  dashboard.on("/api/ai/start", HTTP_POST, startAiAnalysis);
  dashboard.on("/api/ai/status", HTTP_GET, serveAiStatus);
  dashboard.on("/api/cloud/pdf/begin", HTTP_POST, receiveCloudPdfBegin);
  dashboard.on("/api/cloud/pdf/chunk", HTTP_POST, receiveCloudPdfChunk);
  dashboard.on("/api/cloud/start", HTTP_POST, startCloudUpload);
  dashboard.on("/api/cloud/status", HTTP_GET, serveCloudStatus);
  dashboard.on("/api/recording", HTTP_GET, serveRecordedWave);
  dashboard.on("/api/trace", HTTP_GET, serveTrace);
  dashboard.on("/api/sessions", HTTP_GET, serveBenchmarks);
  dashboard.on("/api/diagnostics", HTTP_GET, serveDiagnostics);
  dashboard.on("/api/label", HTTP_POST, saveSessionLabel);
  dashboard.on("/api/sessions", HTTP_DELETE, deleteBenchmark);
  dashboard.begin();
  dashboardOnline = xTaskCreatePinnedToCore(runDashboard, "ecg_web", 6144, nullptr, 1, nullptr, 0) == pdPASS;
  Serial.printf("Dashboard: %s\n", dashboardOnline ? "http://192.168.4.1/" : "unavailable");
}


// ================= TAMPILAN TFT =================
int plotCursor = 0;
float previousPlotY = CENTER_Y;
bool newPlotSegment = true;
bool traceVisible = false;


// Geometri grid konsisten dengan warna latar yang dipakai anti-aliasing.
// Setiap 20 piksel = 0,2 detik. Garis tebal setiap 100 piksel = 1 detik.
constexpr int PLOT_INSET = 4;
constexpr int PLOT_SPAN = PLOT_W - 2 * PLOT_INSET;  // 300 kolom
constexpr int PLOT_GRID_STEP = 20;
constexpr int PLOT_GRID_MAJOR = 100;
constexpr int PLOT_HGRID_STEP = 12;
constexpr int PLOT_HGRID_ORIGIN = PLOT_Y + 9;
constexpr uint16_t PLOT_MAJOR_COLOR = BORDER;


inline uint16_t traceBackground(int x, int y) {
  const int column = x - (PLOT_X + PLOT_INSET);
  // Garis horizontal digambar TERAKHIR di drawPlotGrid(), termasuk perpotongannya.
  if (y >= PLOT_HGRID_ORIGIN && ((y - PLOT_HGRID_ORIGIN) % PLOT_HGRID_STEP) == 0)
    return GRID;
  if (column > 0 && column % PLOT_GRID_MAJOR == 0) return PLOT_MAJOR_COLOR;
  if (column > 0 && column % PLOT_GRID_STEP == 0) return GRID;
  return PANEL;
}


// RGB565 software alpha blending pada raster TFT tanpa mengubah sinyal.
inline uint16_t traceBlend565(uint16_t under, uint16_t over, int opacity) {
  opacity = constrain(opacity, 0, 16);
  const int back = 16 - opacity;
  const int r = ((((under >> 11) & 31) * back) + (((over >> 11) & 31) * opacity) + 8) >> 4;
  const int g = ((((under >> 5) & 63) * back) + (((over >> 5) & 63) * opacity) + 8) >> 4;
  const int b = (((under & 31) * back) + ((over & 31) * opacity) + 8) >> 4;
  return (uint16_t(r) << 11) | (uint16_t(g) << 5) | uint16_t(b);
}


void drawTraceAAPixel(int x, int y, float coverage) {
  if (x < PLOT_X + PLOT_INSET || x >= PLOT_X + PLOT_INSET + PLOT_SPAN || y < PLOT_Y + 5 || y >= PLOT_Y + PLOT_H - 5) return;
  const int alpha = constrain(int(coverage * 16.0f + 0.5f), 0, 16);
  if (alpha == 0) return;
  tft.drawPixel(x, y, traceBlend565(traceBackground(x, y), MINT, alpha));
}


// Xiaolin-Wu style antialiasing untuk segmen 1 kolom.
// Warna subpiksel dibaurkan dengan warna grid/putih sesuai koordinat aktual.
// Inilah AA GEOMETRI: tidak menginterpolasi, memfilter, atau mengganti sampel ECG.
void drawTraceAA(int x0, float y0, int x1, float y1) {
  const float dy = y1 - y0;
  if (fabsf(dy) <= 1.0f) {
    for (int x = x0; x <= x1; ++x) {
      const float y = (x == x0) ? y0 : y1;
      const int iy = int(floorf(y));
      const float frac = y - iy;
      drawTraceAAPixel(x, iy, 1.0f - frac);
      drawTraceAAPixel(x, iy + 1, frac);
    }
    return;
  }
  const float ymin = fminf(y0, y1), ymax = fmaxf(y0, y1);
  for (int yi = int(ceilf(ymin)); yi <= int(floorf(ymax)); ++yi) {
    const float fx = float(x0) + (float(yi) - y0) / dy * float(x1 - x0);
    const int ix = int(floorf(fx));
    const float frac = fx - ix;
    drawTraceAAPixel(ix, yi, 1.0f - frac);
    drawTraceAAPixel(ix + 1, yi, frac);
  }
  // Endpoint coverage: jaga agar puncak dan lembah tetap terlihat.
  const int e0 = int(floorf(y0)), e1 = int(floorf(y1));
  drawTraceAAPixel(x0, e0, 1.0f - (y0 - e0));
  drawTraceAAPixel(x0, e0 + 1, y0 - e0);
  drawTraceAAPixel(x1, e1, 1.0f - (y1 - e1));
  drawTraceAAPixel(x1, e1 + 1, y1 - e1);
}


void drawPlotGrid() {
  portENTER_CRITICAL(&traceLock);
  memset(webTrace + 4, 0, WEB_TRACE_COLUMNS);
  portEXIT_CRITICAL(&traceLock);
  traceVisible = false;
  tft.fillRoundRect(PLOT_X, PLOT_Y, PLOT_W, PLOT_H, 6, PANEL);
  tft.drawRoundRect(PLOT_X, PLOT_Y, PLOT_W, PLOT_H, 6, BORDER);
  for (int col = PLOT_GRID_STEP; col < PLOT_SPAN; col += PLOT_GRID_STEP)
    tft.drawFastVLine(PLOT_X + PLOT_INSET + col, PLOT_Y + 4, PLOT_H - 8,
                      col % PLOT_GRID_MAJOR == 0 ? PLOT_MAJOR_COLOR : GRID);
  for (int y = PLOT_HGRID_ORIGIN; y < PLOT_Y + PLOT_H - 4; y += PLOT_HGRID_STEP)
    tft.drawFastHLine(PLOT_X + 3, y, PLOT_W - 6, GRID);
}


void redrawPlotColumn(int x) {
  const int top = PLOT_Y + 3, bottom = PLOT_Y + PLOT_H - 4;
  const int col = x - (PLOT_X + PLOT_INSET);
  uint16_t bg = PANEL;
  if (col > 0 && col % PLOT_GRID_MAJOR == 0) bg = PLOT_MAJOR_COLOR;
  else if (col > 0 && col % PLOT_GRID_STEP == 0) bg = GRID;
  tft.drawFastVLine(x, top, bottom - top + 1, bg);
  for (int y = PLOT_HGRID_ORIGIN; y < PLOT_Y + PLOT_H - 4; y += PLOT_HGRID_STEP)
    tft.drawPixel(x, y, GRID);
}


// Hanya AUTO-GAIN dan raster untuk TFT; hasil bandpass ECG2 tidak diubah.
// Dengan 300 piksel/100 kolom per detik, ~3 detik terlihat dalam satu sapuan.
void drawPlot(float columnSignal) {
  static float displayScale = 35.0f;
  const float requested = fmaxf(7.0f, fabsf(columnSignal) * 1.30f);
  // Fast attack, slow release agar QRS tetap masuk bingkai dan gain tidak bergetar.
  displayScale = fmaxf(requested, displayScale * 0.9985f);
  float y = CENTER_Y - columnSignal * (PLOT_H * 0.44f) / displayScale;
  y = fmaxf(float(PLOT_Y + 5), fminf(float(PLOT_Y + PLOT_H - 6), y));


  const int x = PLOT_X + PLOT_INSET + plotCursor;
  // Dua kolom dibersihkan, bukan empat: beban TFT per detik setara
  // dengan renderer 50 Hz lama meskipun frekuensi plot menjadi 100 Hz.
  for (int k = 0; k < 2; ++k) {
    const int eraseCol = (plotCursor + k) % PLOT_SPAN;
    redrawPlotColumn(PLOT_X + PLOT_INSET + eraseCol);
  }
  if (!newPlotSegment && plotCursor > 0)
    drawTraceAA(x - 1, previousPlotY, x, y);
  else {
    const int yi = int(floorf(y));
    drawTraceAAPixel(x, yi, 1.0f - (y - yi));
    drawTraceAAPixel(x, yi + 1, y - yi);
  }


  portENTER_CRITICAL(&traceLock);
  webTrace[4 + (plotCursor + 1) % PLOT_SPAN] = 0;
  webTrace[4 + plotCursor] = uint8_t(constrain(int(y + 0.5f) - PLOT_Y, 1, PLOT_H - 1));
  portEXIT_CRITICAL(&traceLock);
  traceVisible = true;
  previousPlotY = y;
  newPlotSegment = false;
  if (++plotCursor >= PLOT_SPAN) {
    plotCursor = 0;
    newPlotSegment = true;
  }
}


// RGB565 font raster blending ONLY (not used by ECG waveform).
uint16_t blendPixel(uint16_t paper, uint16_t ink, int alpha) {
  int back = 15 - alpha;
  int r = ((paper >> 11) * back + (ink >> 11) * alpha + 7) / 15;
  int g = (((paper >> 5) & 63) * back + ((ink >> 5) & 63) * alpha + 7) / 15;
  int b = ((paper & 31) * back + (ink & 31) * alpha + 7) / 15;
  return (r << 11) | (g << 5) | b;
}


