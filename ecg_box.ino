  drawText(SIDE_X + 10, 99, span ? String(mean, 1) : String("--"), TEXT, 3, PANEL);
  drawText(SIDE_X + 10, 132, String(detectedBeats) + " DENYUT QRS", MINT, 1, PANEL);
  drawText(SIDE_X + 10, 151, "DEWASA ISTIRAHAT", MUTED, 1, PANEL);
  const char *label = valid < 5 ? "DATA KURANG" : mean < 59.9999f  ? "DI BAWAH"
                                                : mean > 100.0001f ? "DI ATAS"
                                                                   : "DALAM RENTANG";
  drawText(SIDE_X + 10, 173, label, valid >= 5 && mean >= 60 && mean <= 100 ? MINT : YELLOW, 1, PANEL);
  drawText(SIDE_X + 10, 194, "Acuan 60-100", TEXT, 1, PANEL);
  drawText(SIDE_X + 10, 226, String("Valid ") + valid + "/6", TEXT, 1, PANEL);
  tft.fillRect(0, 268, WIDTH, 52, PALE);
  tft.fillCircle(17, 294, 5, RED);
  drawText(31, 286, "ULANG", TEXT, 2, PALE);
  tft.fillCircle(252, 294, 5, CYAN);
  drawText(266, 286, "MONITOR", TEXT, 2, PALE);
